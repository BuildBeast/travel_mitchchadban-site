---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/2-days-in-machu-picchu-itinerary.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "2 Days in Machu Picchu: Aguas Calientes Itinerary — There & Back Again";
const description = "A first-hand two-night Machu Picchu and Aguas Calientes itinerary, with the archaeological park, town, Butterfly Zoo and the rail journey kept in their recorded order.";
const canonical = "https://travel.mitchchadban.com/2-days-in-machu-picchu-itinerary/";
const image = "/images/2-days-in-machu-picchu-itinerary/machu-picchu-terraces.jpg";
const PROVENANCE = { photography: true };
const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article", headline: "2 Days in Machu Picchu and Aguas Calientes", description, author: { "@type": "Person", name: "Mitch Chadban" }, publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" }, mainEntityOfPage: { "@type": "WebPage", "@id": canonical }, url: canonical, inLanguage: "en-AU", image: `https://travel.mitchchadban.com${image}` },
    { "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" }, { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" }, { "@type": "ListItem", position: 3, name: "2 Days in Machu Picchu and Aguas Calientes", item: canonical } ] },
  ],
}, PROVENANCE);
const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />
  <section class="post-hero" aria-labelledby="machu-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Peru ·&nbsp;<span>Machu Picchu</span>&nbsp;· September 2026</div>
    <h1 id="machu-title" class="post-hero-title"><em>2 Days in Machu Picchu</em><br />and Aguas Calientes</h1>
    <p class="post-hero-sub">A two-night route that keeps the mountain citadel and the town below it in the same frame.</p>
    <div class="post-stats"><div class="stat"><span class="stat-num">2</span><span class="stat-label">Nights</span></div><div class="stat"><span class="stat-num">1</span><span class="stat-label">Town base</span></div><div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div><div class="stat"><span class="stat-num">Peru</span><span class="stat-label">Country</span></div></div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>
  <article class="post-body machu-post-body"><ArticleContent /></article>
  <style is:global>
    .machu-post-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .machu-post-body .article-photo picture, .machu-post-body .article-photo img { display: block; width: 100%; }
    .machu-post-body .article-photo img { height: auto; border: 1px solid rgba(158,207,114,.12); }
    .machu-post-body .article-photo figcaption { margin-top: .65rem; color: rgba(221,232,208,.62); font-size: .95rem; font-style: italic; text-align: center; }
    .machu-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem,4vw,3.2rem); font-weight: 400; line-height: 1.08; }
    .machu-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem,3vw,2.2rem); font-weight: 400; }
    .machu-post-body p, .machu-post-body ul { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .machu-post-body ul { padding-left: 2rem; color: rgba(221,232,208,.86); font-size: 1.18rem; line-height: 1.7; }
    .machu-post-body strong { color: #e7f2da; }
    @media (max-width: 820px) { .machu-post-body .article-photo { margin: 2.5rem 0; } .machu-post-body h2, .machu-post-body h3, .machu-post-body p { max-width: none; } }
  </style>
</BaseLayout>
