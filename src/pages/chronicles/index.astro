import BaseLayout from "../../layouts/BaseLayout.astro";

const pageContent = "<div class=\"content\"><div style=\"margin-top: 0px; margin-bottom: 0px;\" class=\"pages\"><div id=\"C3646697726\" page-url=\"chronicles\" class=\"page\"><a id=\"chronicles\"></a><div class=\"page-layout\"><div class=\"page-content\"><bodycopy style=\"--fit-height: 10px; --resize-parent-width: 100%;\"><div class=\"chronicles-header\">\n  <div class=\"page-label\">The full archive</div>\n  <h1 class=\"chronicles-title\">The <em>Chronicles</em></h1>\n</div>\n\n\n\n<div class=\"grid-section\" id=\"chronicles-grid\">\n  <div class=\"grid-label\">All Chronicles</div>\n\n  <div class=\"posts-grid\">\n    <a class=\"post-card\" href=\"/1-day-in-cordoba/\">\n      <div class=\"post-region\">Seville → Córdoba → Seville</div>\n      <h2 class=\"post-title\">1 Day in Córdoba: The City Between Empires</h2>\n      <p class=\"post-excerpt\">Where Rome, Islam, and Christendom built upon each other's bones</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/10-days-in-sevilla/\">\n      <div class=\"post-region\">Spain · Andalucía · Seville · Córdoba · Granada</div>\n      <h2 class=\"post-title\">10 Days in Sevilla: Andalucía Without Rush</h2>\n      <p class=\"post-excerpt\">Ten days in southern Spain's triumvirate of Moorish inheritance — using Seville as a fixed base, making the region reveal itself not by conquest, but by return.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/3-days-in-tangier-at-the-edge-of-two-worlds/\">\n      <div class=\"post-region\">Morocco · Fes → Tangier → Tarifa → Seville</div>\n      <h2 class=\"post-title\">3 Days in Tangier: At the Edge of Two Worlds</h2>\n      <p class=\"post-excerpt\">Three days in Tangier — the White City that looks toward Africa and Europe at once, and belongs wholly to neither.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/3-days-in-lima-itinerary/\">\n      <div class=\"post-region\">Peru · Lima · South America</div>\n      <h2 class=\"post-title\">3 Days in Lima: The City Beneath the City</h2>\n      <p class=\"post-excerpt\">A first-hand route through Lima’s historic centre, Barranco, Miraflores, archaeological sites and museums.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/italy-morocco-seville-4-week-itinerary/\">\n      <div class=\"post-region\">Bologna · Rome · Marrakech · Rabat · Fes · Tangier · Seville</div>\n      <h2 class=\"post-title\">Italy, Morocco &amp; Seville 4 week Itinerary</h2>\n      <p class=\"post-excerpt\">Bologna · Rome · Marrakech · the Imperial Cities of Morocco · and across the Strait into Andalucía</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/san-marino-day-trip-guide/\">\n      <div class=\"post-region\">Bologna › Rimini › San Marino</div>\n      <h2 class=\"post-title\">San Marino Day Trip Guide</h2>\n      <p class=\"post-excerpt\">A day's passage from Bologna to the mountain nation that time forgot to conquer</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/the-imperial-circuit-morocco-in-14-days/\">\n      <div class=\"post-region\">Morocco · Marrakech · Rabat · Fes · Tangier</div>\n      <h2 class=\"post-title\">The Imperial Circuit: Morocco in 14 Days</h2>\n      <p class=\"post-excerpt\">Marrakech to Rabat to Fes to Tangier — a standalone journey through Morocco's old capitals, with the road running from red walls and desert light to medina shadow, Atlantic wind, and the northern strait.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/4-days-in-bologna/\">\n      <div class=\"post-region\">Italy · Emilia-Romagna · Bologna</div>\n      <h2 class=\"post-title\">4 Days in Bologna: The Fat City's Table</h2>\n      <p class=\"post-excerpt\">A deeper guide to eating in Emilia-Romagna — the old country of ragù, mortadella, Parmigiano-Reggiano, and the settled conviction that lunch deserves reverence.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/six-days-in-rome-at-the-table-of-empires/\">\n      <div class=\"post-region\">Italy · Lazio · Rome</div>\n      <h2 class=\"post-title\">Six Days in Rome at the Table of Empires</h2>\n      <p class=\"post-excerpt\">From Pizzarium near the Vatican to carbonara at Roscioli, from the Colosseum at dawn to Trastevere at dusk — a chronicle of Rome, city of eternal hungers.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/1-day-in-sintra-the-mountain-of-romantic-follies/\">\n      <div class=\"post-region\">Europe · Portugal · Sintra</div>\n      <h2 class=\"post-title\">1 Day in Sintra: The Mountain of Romantic Follies</h2>\n      <p class=\"post-excerpt\">One day from Lisbon on a misty wooded hill where kings and an eccentric millionaire built their fantasies — palace as mood, not monument. Come ticketed.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/2-days-in-evora/\">\n      <div class=\"post-region\">Europe · Portugal · Alentejo</div>\n      <h2 class=\"post-title\">2 Days in Évora: Bones &amp; Roman Stones</h2>\n      <p class=\"post-excerpt\">A single overnight on the Alentejo plain — two thousand years of empire stacked inside one walled white town, with a chapel of bones at its heart.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/4-days-in-lagos-the-coast-of-golden-cliffs/\">\n      <div class=\"post-region\">Europe · Portugal · Algarve</div>\n      <h2 class=\"post-title\">4 Days in Lagos: The Coast of Golden Cliffs</h2>\n      <p class=\"post-excerpt\">Four days on the Algarve done at dawn — ochre cliffs and hidden coves before the heat, the grottoes by boat, and the land running out at Cabo de São Vicente.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/4-days-in-mondim-de-basto/\">\n      <div class=\"post-region\">Europe · Portugal · Tâmega Valley</div>\n      <h2 class=\"post-title\">4 Days in Mondim de Basto</h2>\n      <p class=\"post-excerpt\">Three nights in a mountain town nobody books — the case for stepping off the circuit, built around a wine festival, under a green summit and a white chapel.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/4-weeks-portugal-to-spain-by-rail-road/\">\n      <div class=\"post-region\">Europe · Portugal · Spain</div>\n      <h2 class=\"post-title\">4 Weeks Portugal to Spain by Rail &amp; Road</h2>\n      <p class=\"post-excerpt\">A month from Porto to Barcelona, almost entirely overland — port lodges and a mountain wine festival, fado and the Algarve cliffs, a chapel of bones, the oldest restaurant on earth, and Gaudí's unfinished basilica. Each city the answer to the one before it.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/5-days-in-lisbon-itinerary/\">\n      <div class=\"post-region\">Europe · Portugal · Lisbon</div>\n      <h2 class=\"post-title\">5 Days in Lisbon Itinerary</h2>\n      <p class=\"post-excerpt\">Five days in the city of light and tile — read by climbing, from the castle hill to the river, with fado for the evenings and Sintra a train ride away.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/5-days-in-porto-the-city-the-river-built/\">\n      <div class=\"post-region\">Europe · Portugal · Douro</div>\n      <h2 class=\"post-title\">5 Days in Porto: The City the River Built</h2>\n      <p class=\"post-excerpt\">Five days in the city that turned a river into an industry — granite and gold, the climb up from Ribeira, port across the water, and a sunset for every evening.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/douro-valley-day-trip/\">\n      <div class=\"post-region\">Europe · Portugal · Douro</div>\n      <h2 class=\"post-title\">The Douro Valley — A Day Among the Terraced Vines</h2>\n      <p class=\"post-excerpt\">One day up the river from Porto — where the port is actually born, on hand-cut schist terraces in the oldest demarcated wine region on earth.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/1-day-in-cadiz/\">\n      <div class=\"post-region\">Europe · Andalucía · Cádiz</div>\n      <h2 class=\"post-title\">1 Day in Cádiz — At the Edge of the Known World</h2>\n      <p class=\"post-excerpt\">One day in Cádiz — Europe's oldest city, three thousand years at the Atlantic shore</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/1-day-in-colonia-guell/\">\n      <div class=\"post-region\">Europe · Spain · Catalonia</div>\n      <h2 class=\"post-title\">1 Day in Colònia Güell</h2>\n      <p class=\"post-excerpt\">A quiet half-day from Barcelona to the unfinished crypt where Gaudí ran the upside-down string model that made the Sagrada Família possible. The workshop behind the masterpiece.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/1-day-in-figueres-girona/\">\n      <div class=\"post-region\">Europe · Spain · Catalonia</div>\n      <h2 class=\"post-title\">1 Day in Figueres &amp; Girona</h2>\n      <p class=\"post-excerpt\">One day north from Barcelona — the surrealist's own museum-tomb in Figueres, then the stacked medieval old town of Girona on its painted river. The dream and the record, in that order.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/1-day-in-santiago-de-compostela/\">\n      <div class=\"post-region\">Europe · Spain · Galicia</div>\n      <h2 class=\"post-title\">1 Day in Santiago de Compostela</h2>\n      <p class=\"post-excerpt\">One day north from Porto — the cathedral, the Praza do Obradoiro, the swinging censer, and a Galician lunch at the end of the Camino</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/1-day-in-tarragona-sitges/\">\n      <div class=\"post-region\">Europe · Spain · Catalonia</div>\n      <h2 class=\"post-title\">1 Day in Tarragona &amp; Sitges</h2>\n      <p class=\"post-excerpt\">One day south from Barcelona — a Roman amphitheatre that opens straight onto the Mediterranean at Tarragona, then the white seaside ease of Sitges. The empire and the holiday on the same coast.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/2-days-in-caceres/\">\n      <div class=\"post-region\">Europe · Spain · Extremadura</div>\n      <h2 class=\"post-title\">2 Days in Cáceres: A Medieval City Held in Amber</h2>\n      <p class=\"post-excerpt\">A single overnight at the crossover into Spain — a walled old town so intact it doubles as King's Landing, with storks nesting on the golden towers.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/3-days-in-madrid-the-capital-at-full-volume/\">\n      <div class=\"post-region\">Europe · Spain · Madrid</div>\n      <h2 class=\"post-title\">3 Days in Madrid: The Capital at Full Volume</h2>\n      <p class=\"post-excerpt\">Two dense nights in the loudest, hungriest city of the trip — the world's oldest restaurant, a market lunch, the Arab baths, and Guernica in the quiet.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/3-days-in-seville/\">\n      <div class=\"post-region\">Europe · Spain · Seville</div>\n      <h2 class=\"post-title\">3 Days in Seville: Palace, River and Parasol</h2>\n      <p class=\"post-excerpt\">A three-day Seville route that avoids crossing the city twice — the Real Alcázar and the monumental core, Triana and the river, then Plaza de España and the Setas.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/one-day-in-seville/\">\n      <div class=\"post-region\">Europe · Spain · Seville</div>\n      <h2 class=\"post-title\">One Day in Seville</h2>\n      <p class=\"post-excerpt\">A realistic route for a single day — Plaza de España before the Alcázar gate opens, then the Cathedral, the Archivo and Santa Cruz — and an honest account of what a day cannot hold.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/best-areas-to-stay-in-seville/\">\n      <div class=\"post-region\">Europe · Spain · Seville</div>\n      <h2 class=\"post-title\">Best Areas to Stay in Seville</h2>\n      <p class=\"post-excerpt\">Six neighbourhoods assessed on the things that actually vary — noise after midnight, afternoon shade, price and whether the walk home crosses a river.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/best-things-to-do-in-seville/\">\n      <div class=\"post-region\">Europe · Spain · Seville</div>\n      <h2 class=\"post-title\">Best Things to Do in Seville</h2>\n      <p class=\"post-excerpt\">Sixteen experiences grouped and judged — how long each takes, what it pairs with, what needs booking, and which ones a first visit can reasonably skip.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/best-day-trips-from-seville/\">\n      <div class=\"post-region\">Europe · Andalucía · Day Trips</div>\n      <h2 class=\"post-title\">Best Day Trips from Seville</h2>\n      <p class=\"post-excerpt\">Seven excursions assessed by the shape of the day — Córdoba, Cádiz, Jerez, Itálica, Carmona, Granada and Ronda — including the two that are not worth a day.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/seville-tapas-food-guide/\">\n      <div class=\"post-region\">Europe · Spain · Seville</div>\n      <h2 class=\"post-title\">Seville Tapas and Food Guide</h2>\n      <p class=\"post-excerpt\">How the city actually eats — the three sizes, the price of sitting down, the clock that ruins visitors&#x27; evenings, the markets, and what one documented stay ate.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/4-days-in-valencia-itinerary/\">\n      <div class=\"post-region\">Europe · Spain · Valencia</div>\n      <h2 class=\"post-title\">4 Days in Valencia Itinerary</h2>\n      <p class=\"post-excerpt\">Four days along a missing river — a flood turned into a nine-kilometre garden, Gothic silk at one end and Calatrava's white future at the other, and paella's true home.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/7-days-in-barcelona/\">\n      <div class=\"post-region\">Europe · Spain · Catalonia</div>\n      <h2 class=\"post-title\">7 Days in Barcelona: Gaudí's Unfinished Argument</h2>\n      <p class=\"post-excerpt\">The end of the line — seven days at the trip's busiest base, read through Gaudí and the hill, with three day trips and a cathedral still rising after 140 years.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/one-day-in-barcelona/\">\n      <div class=\"post-region\">Europe · Spain · Catalonia</div>\n      <h2 class=\"post-title\">One Day in Barcelona</h2>\n      <p class=\"post-excerpt\">One argued route for a single day — Park Güell at opening, the Sagrada Família at midday, then downhill through the Eixample and the old city to the harbour, with the cuts named.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/best-things-to-do-in-barcelona/\">\n      <div class=\"post-region\">Europe · Spain · Catalonia</div>\n      <h2 class=\"post-title\">Best Things to Do in Barcelona</h2>\n      <p class=\"post-excerpt\">Nineteen experiences grouped and judged — how long each takes, what it pairs with, what must be booked, and what choosing it displaces.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/best-areas-to-stay-in-barcelona/\">\n      <div class=\"post-region\">Europe · Spain · Catalonia</div>\n      <h2 class=\"post-title\">Best Areas to Stay in Barcelona</h2>\n      <p class=\"post-excerpt\">Seven neighbourhoods weighed on the things that actually vary — late-night travel, street noise, slope, luggage access, and the minutes each one adds to every day.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/barcelona-food-guide/\">\n      <div class=\"post-region\">Europe · Spain · Catalonia</div>\n      <h2 class=\"post-title\">Barcelona Food Guide</h2>\n      <p class=\"post-excerpt\">How the city eats — five traditions untangled, the clock that decides everything, the ordering units, the markets, and what the record actually supports.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/best-day-trips-from-barcelona/\">\n      <div class=\"post-region\">Europe · Spain · Catalonia</div>\n      <h2 class=\"post-title\">Best Day Trips from Barcelona</h2>\n      <p class=\"post-excerpt\">Eight excursions judged by the shape of the day and the transport that decides it — Montserrat, Girona, Figueres, Tarragona, Sitges, Colònia Güell, Vic and cava country.</p>\n    </a>\n\n    <a class=\"post-card\" href=\"/2-days-in-fez-itinerary/\">\n      <div class=\"post-region\">Africa · Morocco · Imperial Circuit</div>\n      <h2 class=\"post-title\">2 Days in Fez Itinerary</h2>\n      <p class=\"post-excerpt\">Two days inside Fez el-Bali — the world's oldest living medina, and the place that resists all description</p>\n    </a>\n  </div>\n</div></bodycopy></div></div></div></div></div>\n\t\t\n\t\n\n\n\n";
const laPazCard = '<a class="post-card" href="/3-days-in-la-paz-itinerary/"><div class="post-region">Bolivia · La Paz · South America</div><h2 class="post-title">3 Days in La Paz: The City in Layers</h2><p class="post-excerpt">A first-hand route through plazas, markets, museums, cable cars and Valle de la Luna.</p></a>';
const telefericoCard = '<a class="post-card" href="/mi-teleferico-la-paz/"><div class="post-region">Bolivia · La Paz · South America</div><h2 class="post-title">Mi Teleférico in La Paz: Riding the City by Cable Car</h2><p class="post-excerpt">A first-hand account of using La Paz’s cable cars as transport, viewpoint and a way to understand the city’s vertical geography.</p></a>';
const machuPicchuCard = '<a class="post-card" href="/2-days-in-machu-picchu-itinerary/"><div class="post-region">Peru · Machu Picchu · South America</div><h2 class="post-title">2 Days in Machu Picchu and Aguas Calientes</h2><p class="post-excerpt">A two-night route through the archaeological park, the rail town below it, Huayna Picchu and the Butterfly Zoo.</p></a>';
const huaynaPicchuCard = '<a class="post-card" href="/huayna-picchu-hike/"><div class="post-region">Peru · Huayna Picchu · South America</div><h2 class="post-title">Huayna Picchu Hike: What the Climb Is Really Like</h2><p class="post-excerpt">A dated route and visual account of the stone trail, mountain views and recorded morning block above Machu Picchu.</p></a>';
const cuscoLaPazCard = '<a class="post-card" href="/cusco-to-la-paz-overnight-bus/"><div class="post-region">Peru → Bolivia · South America</div><h2 class="post-title">Cusco to La Paz by Overnight Bus</h2><p class="post-excerpt">A route-led account of the recorded Transzela journey, its terminals, timing and unresolved border details.</p></a>';
const iguazuCard = '<a class="post-card" href="/iguazu-falls-in-2-days/"><div class="post-region">Argentina · Brazil · Iguazú Falls · South America</div><h2 class="post-title">Iguazú Falls in 2 Days: Argentina and Brazil</h2><p class="post-excerpt">One waterfall system, two countries, and two full days arranged around the route.</p></a>';
const iguazuComparisonCard = '<a class="post-card" href="/iguazu-falls-argentina-vs-brazil/"><div class="post-region">Argentina · Brazil · Iguazú Falls · South America</div><h2 class="post-title">Iguazú Falls: Argentina vs Brazil</h2><p class="post-excerpt">A first-hand comparison of two consecutive park days — route structure, viewpoints, wildlife and the case for visiting both sides.</p></a>';
const buenosAiresCard = '<a class="post-card" href="/5-days-in-buenos-aires-itinerary/"><div class="post-region">Argentina · Buenos Aires · South America</div><h2 class="post-title">5 Days in Buenos Aires: Complete Itinerary</h2><p class="post-excerpt">A first-hand route through the historic centre, neighbourhoods, markets, cultural stops and a recorded Colonia day trip.</p></a>';
const coloniaCard = '<a class="post-card" href="/colonia-del-sacramento-day-trip/"><div class="post-region">Uruguay · Colonia del Sacramento · South America</div><h2 class="post-title">Colonia del Sacramento Day Trip from Buenos Aires</h2><p class="post-excerpt">A careful reconstruction of a recorded day beyond Buenos Aires, with the transport and sightseeing gaps left visible.</p></a>';
const southAmericaPillarCard = '<a class="post-card" href="/24-days-in-south-america-itinerary/"><div class="post-region">Peru · Bolivia · Chile · Argentina · Uruguay · South America</div><h2 class="post-title">24 Days in South America: Peru, Bolivia, Chile, Argentina and Uruguay</h2><p class="post-excerpt">The complete route from Lima to Buenos Aires, through Machu Picchu, La Paz, Santiago, Mendoza, Iguazú and Colonia.</p></a>';
const granadaCard = '<a class="post-card" href="/3-days-in-granada-itinerary/"><div class="post-region">Spain · Andalucía · Europe</div><h2 class="post-title">3 Days in Granada: The Alhambra and the City Below</h2><p class="post-excerpt">A first-hand route through the Alhambra, Generalife, Albaicín and Granada’s historic centre.</p></a>';
const santiagoCard = '<a class="post-card" href="/4-days-in-santiago-itinerary/"><div class="post-region">Chile · Santiago · South America</div><h2 class="post-title">4 Days in Santiago: Complete Itinerary</h2><p class="post-excerpt">A first-hand route through civic Santiago, markets, museums, parks, viewpoints and the streets between them.</p></a>';
const mendozaCard = '<a class="post-card" href="/3-days-in-mendoza-itinerary/"><div class="post-region">Argentina · Mendoza · South America</div><h2 class="post-title">3 Days in Mendoza: Complete Itinerary</h2><p class="post-excerpt">A first-hand route through Mendoza’s parks, city streets, foothill landmarks and recorded wine-country stops.</p></a>';
const pageContentWithLaPaz = pageContent.replace('</div></bodycopy>', `${southAmericaPillarCard}${santiagoCard}${mendozaCard}${granadaCard}${machuPicchuCard}${huaynaPicchuCard}${cuscoLaPazCard}${laPazCard}${telefericoCard}${iguazuCard}${iguazuComparisonCard}${buenosAiresCard}${coloniaCard}</div></bodycopy>`);

