---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/plaza-de-mayo-buenos-aires.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "Plaza de Mayo & Historic Buenos Aires: A First-Hand Route | There & Back Again";
const description = "A first-hand route through Plaza de Mayo and historic Buenos Aires, including the Metropolitan Cathedral, Casa Rosada area and the city’s civic centre.";
const canonical = "https://travel.mitchchadban.com/plaza-de-mayo-buenos-aires/";
const image = "/images/5-days-in-buenos-aires-itinerary/buenos-aires-city-centre-1200w.jpg";
const PROVENANCE = { photography: true };

const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Plaza de Mayo and Historic Buenos Aires",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
      image: `https://travel.mitchchadban.com${image}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "Plaza de Mayo & Historic Buenos Aires", item: canonical },
      ],
    },
  ],
}, PROVENANCE);

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="plaza-de-mayo-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Argentina · Buenos Aires ·&nbsp;<span>September 2026</span></div>
    <h1 id="plaza-de-mayo-title" class="post-hero-title"><em>Plaza de Mayo</em><br />and Historic Buenos Aires</h1>
    <p class="post-hero-sub">A civic route through the centre on arrival day.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">Arrival route</span></div>
      <div class="stat"><span class="stat-num">5</span><span class="stat-label">Civic stops</span></div>
      <div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div>
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">City</span></div>
    </div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>

  <article class="post-body plaza-de-mayo-post-body">
    <ArticleContent />
  </article>

  <style is:global>
    .plaza-de-mayo-post-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .plaza-de-mayo-post-body .article-photo picture,
    .plaza-de-mayo-post-body .article-photo img { display: block; width: 100%; }
    .plaza-de-mayo-post-body .article-photo img { height: auto; border: 1px solid rgba(158, 207, 114, 0.12); }
    .plaza-de-mayo-post-body .article-photo figcaption { margin-top: 0.65rem; color: rgba(221, 232, 208, 0.62); font-size: 0.95rem; font-style: italic; text-align: center; }
    .plaza-de-mayo-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.08; }
    .plaza-de-mayo-post-body p,
    .plaza-de-mayo-post-body table { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .plaza-de-mayo-post-body strong { color: #e7f2da; }
    .plaza-de-mayo-post-body table { border-collapse: collapse; color: rgba(221, 232, 208, 0.86); font-size: 1.05rem; line-height: 1.5; width: 100%; }
    .plaza-de-mayo-post-body th,
    .plaza-de-mayo-post-body td { border-bottom: 1px solid rgba(158, 207, 114, 0.2); padding: 0.9rem 0.75rem; text-align: left; vertical-align: top; }
    .plaza-de-mayo-post-body th { color: #e7f2da; font-family: 'IM Fell English', Georgia, serif; font-size: 1.25rem; font-weight: 400; }
    @media (max-width: 820px) {
      .plaza-de-mayo-post-body .article-photo { margin: 2.5rem 0; }
      .plaza-de-mayo-post-body h2,
      .plaza-de-mayo-post-body p,
      .plaza-de-mayo-post-body table { max-width: none; }
      .plaza-de-mayo-post-body table { display: block; overflow-x: auto; }
    }
  </style>
</BaseLayout>
