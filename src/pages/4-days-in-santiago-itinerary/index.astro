---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/4-days-in-santiago-itinerary.md";
import AtAGlance from "../../components/chronicle/AtAGlance.astro";
import Beat from "../../components/chronicle/Beat.astro";
import Practical from "../../components/chronicle/Practical.astro";
import PracticalSection from "../../components/chronicle/PracticalSection.astro";
import TourRecommendations from "../../components/chronicle/TourRecommendations.astro";
import "../../styles/south-america-article.css";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "4 Days in Santiago: Complete Itinerary — There & Back Again";
const description = "A first-hand four-day Santiago itinerary through the civic centre, museums, markets, parks, viewpoints and neighbourhoods of Chile’s capital.";
const canonical = "https://there-and-back.mitchchadban.com/4-days-in-santiago-itinerary/";
const image = "/images/4-days-in-santiago-itinerary/santiago-skyline-mountain-backdrop-1200w.jpg";
const PROVENANCE = { photography: true };
const faqItems = [
  {
    question: "Is four days enough for Santiago?",
    answer: "Yes. Four nights allow a central civic day, a market-and-museum day, a day through Yungay and the Sound Museum, and a final day for the viewpoints without treating every stop as a rushed visit.",
  },
  {
    question: "What is the best way to organise four days in Santiago?",
    answer: "Keep the first day central, combine Vega Central with the Pre-Columbian Art Museum and Parque Forestal, use the third day for Cementerio General, Yungay and the Sound Museum, then group San Cristóbal Hill, Sky Costanera and Santa Lucía Hill according to the view you want. Check current opening and access details before fixing the order.",
  },
  {
    question: "Which Santiago viewpoint is best?",
    answer: "There is no single answer in this itinerary. San Cristóbal gives the city-and-mountain relationship, Sky Costanera gives a high built panorama and Santa Lucía keeps the view close to the centre. Two are enough to make the contrast clear.",
  },
  {
    question: "Is Santiago easy to get around without a car?",
    answer: "The central sequence is walkable, while longer movements between the northern, western and elevated stops need Metro or another local transfer. Plan each day as a connected area rather than trying to walk across the whole city.",
  },
  {
    question: "How do you get from Santiago to Mendoza?",
    answer: "The recorded journey continued from Terminal Sur at 10:00 am on 23 September, arriving in Mendoza around 4:00 pm by bus. Keep the morning clear, reach the terminal early and check current operator and border details before travel.",
  },
];
const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article", headline: "4 Days in Santiago: Complete Itinerary", description, author: { "@type": "Person", name: "Mitch Chadban" }, publisher: { "@type": "Organization", name: "There & Back Again", url: "https://there-and-back.mitchchadban.com/" }, mainEntityOfPage: { "@type": "WebPage", "@id": canonical }, url: canonical, inLanguage: "en-AU", image: `https://there-and-back.mitchchadban.com${image}` },
    { "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Home", item: "https://there-and-back.mitchchadban.com/" }, { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://there-and-back.mitchchadban.com/chronicles/" }, { "@type": "ListItem", position: 3, name: "4 Days in Santiago: Complete Itinerary", item: canonical } ] },
    { "@type": "FAQPage", mainEntity: faqItems.map(({ question, answer }) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) },
  ],
}, PROVENANCE);
const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />
  <section class="post-hero" aria-labelledby="santiago-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Chile ·&nbsp;<span>Santiago</span>&nbsp;· September 2026</div>
    <h1 id="santiago-title" class="post-hero-title"><em>4 Days in Santiago:</em><br />Complete Itinerary</h1>
    <p class="post-hero-sub">A first-hand route through civic Santiago, markets, museums, parks, viewpoints and the streets between them.</p>
    <div class="post-stats"><div class="stat"><span class="stat-num">4</span><span class="stat-label">Nights</span></div><div class="stat"><span class="stat-num">1</span><span class="stat-label">City base</span></div><div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div><div class="stat"><span class="stat-num">Chile</span><span class="stat-label">Country</span></div></div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: true })} />
  </section>
  <article class="post-body south-america-post-body santiago-post-body"><ArticleContent /></article>
  <div class="santiago-day-support-slots" aria-label="Day-by-day practical planning">
    <div class="santiago-day-support-slot" data-day="1">
      <Practical place="Santiago — Day 1" detail="Civic centre · 19 September" placeIcon="" detailIcon="">
        <PracticalSection label="Where to Eat">
          <div class="prac-item"><strong>El Hoyo</strong> — arrival-night meal recorded after reaching Santiago.</div>
        </PracticalSection>
        <PracticalSection label="Getting There">
          <div class="prac-item"><strong>Arrival</strong> — flight from La Paz reached Santiago at 2:24pm; the central accommodation handoff followed before the civic-centre sequence.</div>
        </PracticalSection>
        <PracticalSection label="Day Focus / Excursion">
          <div class="prac-item"><strong>Civic centre</strong> — La Moneda Cultural Center, Metropolitan Cathedral and Estación Mapocho.</div>
        </PracticalSection>
        <section class="practical" aria-label="Santiago Day 1 budget snapshot">
          <div class="prac-header"><div class="prac-city">Santiago — Budget snapshot</div><div class="prac-dates">Planning estimate</div></div>
          <div class="budget-grid">
            <div class="budget-cell"><div class="budget-cat">Accommodation</div><div class="budget-val">~A$150/night</div></div>
            <div class="budget-cell"><div class="budget-cat">Food daily</div><div class="budget-val">~A$30</div></div>
            <div class="budget-cell"><div class="budget-cat">Transport</div><div class="budget-val">~A$7/day</div></div>
            <div class="budget-cell"><div class="budget-cat">Daily total</div><div class="budget-val">~A$205–210</div></div>
          </div>
        </section>
        <PracticalSection label="Tips & Watch-outs">
          <div class="tip-row">Keep the first afternoon central.</div>
          <div class="tip-row">Check current civic-building access before setting out.</div>
          <div class="tip-row">Walk the central cluster rather than overloading the arrival day.</div>
        </PracticalSection>
      </Practical>
      <TourRecommendations label="Book it — Santiago Day 1 experiences" tours={[
        { category: "Historic Centre", title: "Santiago de Chile Historic City Tour", description: "A guided introduction to Plaza de Armas, central Santiago and Santa Lucía Hill.", href: "https://www.viator.com/tours/Santiago/Santiago-de-Chile-Sightseeing-Tour/d713-5674P1043?pid=P00295455&mcid=42383&medium=link", featured: true },
        { category: "City Walking", title: "Santiago de Chile Small-Group Guided City Walking Tour", description: "A three-hour walking introduction to Santiago’s historic centre, La Moneda, museums and central neighbourhoods.", href: "https://www.viator.com/tours/Santiago/Walking-Tour-through-the-History-of-Santiago-de-Chile/d713-360835P1?pid=P00295455&mcid=42383&medium=link" },
      ]} />
      <Beat>But the road is ever onward.</Beat>
    </div>

    <div class="santiago-day-support-slot" data-day="2">
      <Practical place="Santiago — Day 2" detail="Market, museum and park · 20 September" placeIcon="" detailIcon="">
        <PracticalSection label="Where to Eat">
          <div class="prac-item"><strong>Carmen’s</strong> — meal stop on the La Vega Chica / Vega Central sequence.</div>
          <div class="prac-item"><strong>Bocanáriz</strong> — recorded evening stop after the museum and park route.</div>
        </PracticalSection>
        <PracticalSection label="Getting There">
          <div class="prac-item"><strong>Central sequence</strong> — walk between Estación Mapocho, Vega Central, the Pre-Columbian Art Museum, Parque Forestal and the Fine Arts Museum, using local transport if the wider day requires it.</div>
        </PracticalSection>
        <PracticalSection label="Day Focus / Excursion">
          <div class="prac-item"><strong>Market, museum and park</strong> — allow time for Vega rather than treating it as a pass-through, then choose museum depth over checklist speed.</div>
        </PracticalSection>
        <section class="practical" aria-label="Santiago Day 2 budget snapshot">
          <div class="prac-header"><div class="prac-city">Santiago — Budget snapshot</div><div class="prac-dates">Planning estimate</div></div>
          <div class="budget-grid">
            <div class="budget-cell"><div class="budget-cat">Accommodation</div><div class="budget-val">~A$150/night</div></div>
            <div class="budget-cell"><div class="budget-cat">Food daily</div><div class="budget-val">~A$30</div></div>
            <div class="budget-cell"><div class="budget-cat">Transport</div><div class="budget-val">~A$7/day</div></div>
            <div class="budget-cell"><div class="budget-cat">Daily total</div><div class="budget-val">~A$205–210</div></div>
          </div>
        </section>
        <PracticalSection label="Tips & Watch-outs">
          <div class="tip-row">Allow time for Vega rather than treating it as a pass-through.</div>
          <div class="tip-row">Choose museum depth over checklist speed.</div>
          <div class="tip-row">Keep Parque Forestal as part of the route.</div>
        </PracticalSection>
      </Practical>
      <TourRecommendations label="Book it — Santiago Day 2 experiences" tours={[
        { category: "Food & Market", title: "Small-Group Santiago Food and Market Tour", description: "A four-hour food-and-market experience linking central Santiago with Mercado Central and local tastings.", href: "https://www.viator.com/tours/Santiago/Small-Group-Santiago-Food-and-Market-Tour-Including-Mercado-Central/d713-5684SCLFOOD?pid=P00295455&mcid=42383&medium=link", featured: true },
        { category: "Cooking & Culture", title: "Santiago de Chile Cooking and Culture Class with Market Visit", description: "A half-day market and cooking experience built around Chilean food and a central Santiago market visit.", href: "https://www.viator.com/tours/Santiago/Cooking-Class-in-Santiago-de-Chile/d713-118895P2?pid=P00295455&mcid=42383&medium=link" },
      ]} />
      <Beat>But the road is ever onward.</Beat>
    </div>

    <div class="santiago-day-support-slot" data-day="3">
      <Practical place="Santiago — Day 3" detail="Neighbourhood and cultural day · 21 September" placeIcon="" detailIcon="">
        <PracticalSection label="Where to Eat">
          <div class="prac-item"><strong>Peumayén Ancestral Food</strong> — booked evening meal recorded after the Yungay, Sound Museum, Sky Costanera and Bahá’í Temple sequence.</div>
        </PracticalSection>
        <PracticalSection label="Getting There">
          <div class="prac-item"><strong>Cross-city movement</strong> — allow transport between the central, northern and western stops rather than treating Cementerio General, Yungay and the Sound Museum as one compact walking loop.</div>
        </PracticalSection>
        <PracticalSection label="Day Focus / Excursion">
          <div class="prac-item"><strong>Neighbourhood and cultural day</strong> — Cementerio General, Yungay and Museo del Sonido, with the surrounding streets doing part of the work.</div>
        </PracticalSection>
        <section class="practical" aria-label="Santiago Day 3 budget snapshot">
          <div class="prac-header"><div class="prac-city">Santiago — Budget snapshot</div><div class="prac-dates">Planning estimate</div></div>
          <div class="budget-grid">
            <div class="budget-cell"><div class="budget-cat">Accommodation</div><div class="budget-val">~A$150/night</div></div>
            <div class="budget-cell"><div class="budget-cat">Food daily</div><div class="budget-val">~A$30</div></div>
            <div class="budget-cell"><div class="budget-cat">Transport</div><div class="budget-val">~A$7/day</div></div>
            <div class="budget-cell"><div class="budget-cat">Daily total</div><div class="budget-val">~A$205–210</div></div>
          </div>
        </section>
        <PracticalSection label="Tips & Watch-outs">
          <div class="tip-row">Allow transport between northern and western stops.</div>
          <div class="tip-row">Check museum opening days before leaving.</div>
          <div class="tip-row">Avoid overpacking the day.</div>
        </PracticalSection>
      </Practical>
      <TourRecommendations label="Book it — Santiago Day 3 experiences" tours={[
        { category: "Yungay", title: "2-Hour Walking Tour of Yungay", description: "A focused walk through Yungay’s squares, heritage streets and cultural history, with a route that suits this day’s neighbourhood emphasis.", href: "https://www.viator.com/tours/Santiago/2-Hour-Walking-Tour-of-Yungay-The-Coolest-Neighborhood-in-Chile/d713-360835P3?pid=P00295455&mcid=42383&medium=link", featured: true },
        { category: "Memory & Heritage", title: "Santiago Barrio Yungay Street Art Walking Tour Experience", description: "A two- to three-hour Yungay experience connecting neighbourhood history, cultural memory and the streets beyond central Santiago.", href: "https://www.viator.com/tours/Santiago/R-and-R-Yungay-Memory-Art-and-Neighborhood-Walking-Tour/d713-5570716P9?pid=P00295455&mcid=42383&medium=link" },
      ]} />
      <Beat>But the road is ever onward.</Beat>
    </div>

    <div class="santiago-day-support-slot" data-day="4">
      <Practical place="Santiago — Day 4" detail="The city from above · 22 September" placeIcon="" detailIcon="">
        <PracticalSection label="Getting There">
          <div class="prac-item"><strong>Viewpoint sequence</strong> — use local transport strategically between San Cristóbal Hill, Sky Costanera and Santa Lucía Hill; two viewpoints are enough.</div>
        </PracticalSection>
        <PracticalSection label="Day Trip / Excursion">
          <div class="prac-item"><strong>San Cristóbal Hill</strong> — city edge and mountain relationship.</div>
          <div class="prac-item"><strong>Sky Costanera</strong> — high built panorama.</div>
          <div class="prac-item"><strong>Santa Lucía Hill</strong> — central viewpoint close to the historic core.</div>
        </PracticalSection>
        <section class="practical" aria-label="Santiago Day 4 budget snapshot">
          <div class="prac-header"><div class="prac-city">Santiago — Budget snapshot</div><div class="prac-dates">Planning estimate</div></div>
          <div class="budget-grid">
            <div class="budget-cell"><div class="budget-cat">Accommodation</div><div class="budget-val">~A$150/night</div></div>
            <div class="budget-cell"><div class="budget-cat">Food daily</div><div class="budget-val">~A$30</div></div>
            <div class="budget-cell"><div class="budget-cat">Transport</div><div class="budget-val">~A$7/day</div></div>
            <div class="budget-cell"><div class="budget-cat">Daily total</div><div class="budget-val">~A$205–210</div></div>
          </div>
        </section>
        <PracticalSection label="Tips & Watch-outs">
          <div class="tip-row">Two viewpoints can be enough.</div>
          <div class="tip-row">Choose by light and geography.</div>
          <div class="tip-row">Check access, weather and visibility before setting out.</div>
        </PracticalSection>
      </Practical>
      <TourRecommendations label="Book it — Santiago Day 4 experiences" tours={[
        { category: "Viewpoints", title: "Santiago Skyline: Cable Car and San Cristóbal Walking Tour", description: "A two-and-a-half-hour guided viewpoint experience combining San Cristóbal, the funicular and cable-car perspective over the city.", href: "https://www.viator.com/tours/Santiago/Santiago-Skyline-San-Cristobal-and-Cable-Car-Semi-Private-Tour/d713-5569161P9?pid=P00295455&mcid=42383&medium=link", featured: true },
        { category: "Andes Extension", title: "Cajón del Maipo and Embalse el Yeso", description: "An optional full-day extension from Santiago into the Andes, for travellers who want to replace the city viewpoint day with a wider mountain excursion.", href: "https://www.viator.com/tours/Santiago/Cajon-del-Maipo-Embalse-el-Yeso/d713-182663P16?pid=P00295455&mcid=42383&medium=link" },
      ]} />
      <Beat>But the road is ever onward.</Beat>
    </div>
  </div>
  <article class="post-body south-america-post-body santiago-post-body">
    <h2>A City in Changing Forms</h2>
    <p>
      Across four days, Santiago moves from government buildings to markets, from museums to parks, from older neighbourhoods to hills and towers. Each change makes the last place easier to read: the market brings the city’s working life beside the formal centre; the museums and parks give it an interior life; the elevated views show how all of it sits against the mountains.
    </p>
    <p>
      Then the bus leaves east for Mendoza. The city does not resolve into one final landmark. It remains a set of connected contrasts, carried forward into the next stage of the journey.
    </p>
    <p>But the road is ever onward.</p>
    <p>
      See the wider <a href="/24-days-in-south-america-itinerary/">24 Days in South America itinerary</a>, then continue to the <a href="/3-days-in-mendoza-itinerary/">three-day Mendoza itinerary</a>.
    </p>
  </article>
  <AtAGlance
    id="full-itinerary"
    title="The Full Itinerary at a Glance"
    meta={[
      { label: "Trip", value: "Four nights in Santiago, arriving from La Paz and departing by bus to Mendoza." },
      { label: "Duration", value: "4 days / 4 nights." },
      { label: "Country", value: "Chile." },
      { label: "Travelled", value: "September 2026." },
    ]}
    days={[
      { num: "Day 1", text: "Civic centre — La Moneda, Metropolitan Cathedral and Estación Mapocho." },
      { num: "Day 2", text: "Vega Central, Pre-Columbian Art Museum, Parque Forestal and Fine Arts Museum." },
      { num: "Day 3", text: "Cementerio General, Yungay and Sound Museum." },
      { num: "Day 4", text: "San Cristóbal Hill, Sky Costanera and Santa Lucía Hill." },
      { num: "Departure morning", text: "Terminal Sur → Mendoza — 10:00am departure, around 4:00pm arrival." },
    ]}
  >
    <div class="itin-section-head">Budget Snapshot — Planning Estimate</div>
    <div class="grand-total-block">
      <div class="grand-total-grid">
        <div class="grand-line"><strong>Accommodation</strong>~A$150/night</div>
        <div class="grand-line"><strong>Food daily</strong>~A$30</div>
        <div class="grand-line"><strong>Transport</strong>~A$7/day</div>
        <div class="grand-line"><strong>Daily total</strong>~A$205–210</div>
      </div>
      <div class="grand-total-num">Estimated Santiago budget: ~A$820–840</div>
    </div>

    <div class="itin-section-head">Quick Reference — Best Eats</div>
    <div class="eats-row"><span class="eats-city">Santiago</span><span><strong>El Hoyo</strong> — arrival-night meal.</span></div>
    <div class="eats-row"><span class="eats-city">Santiago</span><span><strong>Carmen’s</strong> — La Vega Chica / Vega Central day.</span></div>
    <div class="eats-row"><span class="eats-city">Santiago</span><span><strong>Bocanáriz</strong> — museum and park day.</span></div>
    <div class="eats-row"><span class="eats-city">Santiago</span><span><strong>Peumayén Ancestral Food</strong> — booked evening meal.</span></div>

    <div class="itin-section-head">Getting Around</div>
    <div class="transport-note"><strong>Central Santiago:</strong> Walk between the civic centre, museums, parks and nearby cultural stops.</div>
    <div class="transport-note"><strong>Longer movements:</strong> Use Metro or another local transfer between northern, western and elevated stops.</div>
    <div class="transport-note"><strong>Viewpoints:</strong> Use transport strategically rather than trying to connect every hill on foot.</div>
    <div class="transport-note"><strong>Departure:</strong> Terminal Sur bus to Mendoza at 10:00am on 23 September.</div>
  </AtAGlance>

  <section class="faq-block" aria-labelledby="santiago-faq-title">
    <div class="faq-inner">
      <div class="faq-title" id="santiago-faq-title">Frequently Asked Questions</div>
      {faqItems.map((item) => (
        <div class="faq-item">
          <div class="faq-q">{item.question}</div>
          <div class="faq-a">{item.answer}</div>
        </div>
      ))}
    </div>
  </section>

  <div class="next-chronicles">
    <div class="section-label">Next Chronicles</div>
    <div class="posts-grid">
      <a class="post-card chronicle-card" href="/best-things-to-do-in-santiago/">
        <div class="post-region">Chile · Santiago</div>
        <div class="post-title">Best Things to Do in Santiago</div>
        <div class="post-excerpt">A focused guide to Santiago’s civic centre, Vega Central, museums, parks, older neighbourhoods and elevated views.</div>
        <div class="post-meta">READ CHRONICLE</div>
      </a>
      <a class="post-card chronicle-card" href="/santiago-viewpoints/">
        <div class="post-region">Chile · Santiago</div>
        <div class="post-title">Santiago Viewpoints</div>
        <div class="post-excerpt">A direct comparison of San Cristóbal Hill, Santa Lucía Hill and Sky Costanera, and the different city perspectives they provide.</div>
        <div class="post-meta">READ CHRONICLE</div>
      </a>
      <a class="post-card chronicle-card" href="/3-days-in-mendoza-itinerary/">
        <div class="post-region">Argentina · Mendoza</div>
        <div class="post-title">3 Days in Mendoza</div>
        <div class="post-excerpt">The next stage after Santiago: central streets, Parque General San Martín, foothill landmarks and wine country.</div>
        <div class="post-meta">READ CHRONICLE</div>
      </a>
    </div>
  </div>

  <script is:inline>
    (() => {
      const slots = [...document.querySelectorAll('.santiago-day-support-slot')];
      const article = document.querySelector('.santiago-post-body');
      if (!article) return;
      for (const slot of slots) {
        const heading = [...article.querySelectorAll('h2')].find((item) => item.textContent?.trim().startsWith(`Day ${slot.dataset.day} `));
        if (!heading) continue;
        let node = heading.nextElementSibling;
        let figure = null;
        while (node && !node.matches('h2')) {
          if (node.matches('figure')) figure = node;
          node = node.nextElementSibling;
        }
        if (figure) figure.insertAdjacentElement('afterend', slot);
      }
    })();
  </script>
</BaseLayout>
