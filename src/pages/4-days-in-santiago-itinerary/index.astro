---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/4-days-in-santiago-itinerary.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "4 Days in Santiago: Complete Itinerary — There & Back Again";
const description = "A first-hand four-day Santiago itinerary through the civic centre, museums, markets, parks, viewpoints and neighbourhoods of Chile’s capital.";
const canonical = "https://travel.mitchchadban.com/4-days-in-santiago-itinerary/";
const image = "/images/4-days-in-santiago-itinerary/santiago-skyline-mountain-backdrop-1200w.jpg";
const PROVENANCE = { photography: true };
const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article", headline: "4 Days in Santiago: Complete Itinerary", description, author: { "@type": "Person", name: "Mitch Chadban" }, publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" }, mainEntityOfPage: { "@type": "WebPage", "@id": canonical }, url: canonical, inLanguage: "en-AU", image: `https://travel.mitchchadban.com${image}` },
    { "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" }, { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" }, { "@type": "ListItem", position: 3, name: "4 Days in Santiago: Complete Itinerary", item: canonical } ] },
  ],
}, PROVENANCE);
const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />
  <section class="post-hero" aria-labelledby="santiago-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Chile ·&nbsp;<span>Santiago</span>&nbsp;· September 2026</div>
    <h1 id="santiago-title" class="post-hero-title"><em>4 Days in Santiago:</em><br />Complete Itinerary</h1>
    <p class="post-hero-sub">A first-hand route through civic Santiago, markets, museums, parks, viewpoints and the streets between them.</p>
    <div class="post-stats"><div class="stat"><span class="stat-num">4</span><span class="stat-label">Nights</span></div><div class="stat"><span class="stat-num">1</span><span class="stat-label">City base</span></div><div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div><div class="stat"><span class="stat-num">Chile</span><span class="stat-label">Country</span></div></div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>
  <article class="post-body santiago-post-body"><ArticleContent /></article>
  <style is:global>
    .santiago-post-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .santiago-post-body .article-photo picture, .santiago-post-body .article-photo img { display: block; width: 100%; }
    .santiago-post-body .article-photo img { height: auto; border: 1px solid rgba(158, 207, 114, 0.12); }
    .santiago-post-body .article-photo figcaption { margin-top: .65rem; color: rgba(221,232,208,.62); font-size: .95rem; font-style: italic; text-align: center; }
    .santiago-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem,4vw,3.2rem); font-weight: 400; line-height: 1.08; }
    .santiago-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem,3vw,2.2rem); font-weight: 400; }
    .santiago-post-body p, .santiago-post-body ul { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .santiago-post-body ul { padding-left: 2rem; color: rgba(221,232,208,.86); font-size: 1.18rem; line-height: 1.7; }
    .santiago-post-body strong { color: #e7f2da; }
    @media (max-width: 820px) { .santiago-post-body .article-photo { margin: 2.5rem 0; } .santiago-post-body h2, .santiago-post-body h3, .santiago-post-body p { max-width: none; } }
  </style>
</BaseLayout>
