    />

    <AtAGlance
      id="buenos-aires-glance"
      title="Buenos Aires at a Glance"
      meta={[
        { label: 'Best first stop', value: 'Plaza de Mayo and the historic centre for the city’s political and civic core.' },
        { label: 'Best cultural route', value: 'Teatro Colón, El Ateneo and Recoleta for architecture, books, museums and grand institutions.' },
        { label: 'Best neighbourhood contrast', value: 'San Telmo, Puerto Madero and La Boca for market streets, waterfront redevelopment and football identity.' },
        { label: 'Best place to slow down', value: 'Palermo, where parks and wider streets give the city room to breathe.' },
      ]}
      daysHeading="Five Ways into Buenos Aires"
      days={[
        { num: 'Civic Buenos Aires', detail: 'Plaza de Mayo · Congress · Historic centre', text: 'The political and historical starting point, where national institutions and the old centre sit within one urban sequence.' },
        { num: 'Cultural Buenos Aires', detail: 'Teatro Colón · El Ateneo · Museums', text: 'The city at its most institutional: theatre, books, art and architecture folded into the central and northern districts.' },
