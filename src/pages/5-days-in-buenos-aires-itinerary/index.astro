---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/5-days-in-buenos-aires-itinerary.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "5 Days in Buenos Aires: Complete Itinerary — There & Back Again";
const description = "A first-hand five-day Buenos Aires itinerary through the city’s neighbourhoods, markets, cultural stops and a Colonia del Sacramento day trip, based on a September–October 2026 visit.";
const canonical = "https://travel.mitchchadban.com/5-days-in-buenos-aires-itinerary/";
const image = "/images/5-days-in-buenos-aires-itinerary/buenos-aires-city-centre-1200w.jpg";
const PROVENANCE = { photography: true };

const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "5 Days in Buenos Aires: Complete Itinerary",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
      image: `https://travel.mitchchadban.com${image}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "5 Days in Buenos Aires: Complete Itinerary", item: canonical },
      ],
    },
  ],
}, PROVENANCE);

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="buenos-aires-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Argentina · Buenos Aires ·&nbsp;<span>September–October 2026</span></div>
    <h1 id="buenos-aires-title" class="post-hero-title"><em>5 Days in Buenos Aires:</em><br />Complete Itinerary</h1>
    <p class="post-hero-sub">A first-hand route through the historic centre, Recoleta, Palermo, San Telmo, Puerto Madero, La Boca and a recorded Colonia day trip.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">5</span><span class="stat-label">Nights</span></div>
      <div class="stat"><span class="stat-num">6</span><span class="stat-label">Dates</span></div>
      <div class="stat"><span class="stat-num">Sep–Oct</span><span class="stat-label">Visited</span></div>
      <div class="stat"><span class="stat-num">Palermo</span><span class="stat-label">Base</span></div>
    </div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>

  <article class="post-body buenos-aires-post-body">
    <ArticleContent />
  </article>

  <style is:global>
    .buenos-aires-post-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .buenos-aires-post-body .article-photo picture,
    .buenos-aires-post-body .article-photo img { display: block; width: 100%; }
    .buenos-aires-post-body .article-photo img { height: auto; border: 1px solid rgba(158, 207, 114, 0.12); }
    .buenos-aires-post-body .article-photo figcaption { margin-top: 0.65rem; color: rgba(221, 232, 208, 0.62); font-size: 0.95rem; font-style: italic; text-align: center; }
    .buenos-aires-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.08; }
    .buenos-aires-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem, 3vw, 2.2rem); font-weight: 400; }
    .buenos-aires-post-body p,
    .buenos-aires-post-body ul,
    .buenos-aires-post-body ol { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .buenos-aires-post-body ul,
    .buenos-aires-post-body ol { padding-left: 2rem; color: rgba(221, 232, 208, 0.86); font-size: 1.18rem; line-height: 1.7; }
    .buenos-aires-post-body strong { color: #e7f2da; }
    @media (max-width: 820px) {
      .buenos-aires-post-body .article-photo { margin: 2.5rem 0; }
      .buenos-aires-post-body h2,
      .buenos-aires-post-body h3,
      .buenos-aires-post-body p,
      .buenos-aires-post-body ul,
      .buenos-aires-post-body ol { max-width: none; }
    }
  </style>
</BaseLayout>
