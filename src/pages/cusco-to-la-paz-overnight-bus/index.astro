---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/cusco-to-la-paz-overnight-bus.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "Cusco to La Paz by Overnight Bus: What to Expect — There & Back Again";
const description = "A first-hand, evidence-led account of the recorded Cusco-to-La Paz overnight bus journey on 15–16 September 2026, including the operator, terminals, timing and unresolved border details.";
const canonical = "https://travel.mitchchadban.com/cusco-to-la-paz-overnight-bus/";
const PROVENANCE = { photography: false };
const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article", headline: "Cusco to La Paz by Overnight Bus: What the Journey Is Really Like", description, author: { "@type": "Person", name: "Mitch Chadban" }, publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" }, mainEntityOfPage: { "@type": "WebPage", "@id": canonical }, url: canonical, inLanguage: "en-AU" },
    { "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" }, { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" }, { "@type": "ListItem", position: 3, name: "Cusco to La Paz by Overnight Bus", item: canonical } ] },
  ],
}, PROVENANCE);
const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article">
  <Fragment slot="head" set:html={jsonLd} />
  <section class="post-hero" aria-labelledby="cusco-la-paz-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Peru → Bolivia ·&nbsp;<span>Cusco to La Paz</span>&nbsp;· September 2026</div>
    <h1 id="cusco-la-paz-title" class="post-hero-title"><em>Cusco to La Paz by Overnight Bus:</em><br />What the Journey Is Really Like</h1>
    <p class="post-hero-sub">A route-led account of the recorded international bus journey between Machu Picchu and La Paz.</p>
    <div class="post-stats"><div class="stat"><span class="stat-num">15h</span><span class="stat-label">Recorded journey</span></div><div class="stat"><span class="stat-num">10pm</span><span class="stat-label">Departure</span></div><div class="stat"><span class="stat-num">1pm</span><span class="stat-label">Arrival</span></div><div class="stat"><span class="stat-num">2</span><span class="stat-label">Countries</span></div></div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>
  <article class="post-body cusco-la-paz-post-body"><ArticleContent /></article>
  <style is:global>
    .cusco-la-paz-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem,4vw,3.2rem); font-weight: 400; line-height: 1.08; }
    .cusco-la-paz-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem,3vw,2.2rem); font-weight: 400; }
    .cusco-la-paz-post-body p, .cusco-la-paz-post-body ul { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .cusco-la-paz-post-body ul { padding-left: 2rem; color: rgba(221,232,208,.86); font-size: 1.18rem; line-height: 1.7; }
    .cusco-la-paz-post-body strong { color: #e7f2da; }
    @media (max-width: 820px) { .cusco-la-paz-post-body h2, .cusco-la-paz-post-body h3, .cusco-la-paz-post-body p { max-width: none; } }
  </style>
</BaseLayout>
