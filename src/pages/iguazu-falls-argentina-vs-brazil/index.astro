---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/iguazu-falls-argentina-vs-brazil.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "Iguazú Falls: Argentina vs Brazil — Which Side Is Better? | There & Back Again";
const description = "A first-hand comparison of the Argentina and Brazil sides of Iguazú Falls, based on two consecutive September 2026 park days and the routes actually recorded.";
const canonical = "https://travel.mitchchadban.com/iguazu-falls-argentina-vs-brazil/";
const image = "/images/iguazu-falls-in-2-days/iguazu-falls-panorama-1200w.jpg";
const PROVENANCE = { photography: true };

const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Iguazú Falls: Argentina vs Brazil",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
      image: `https://travel.mitchchadban.com${image}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "Iguazú Falls: Argentina vs Brazil", item: canonical },
      ],
    },
  ],
}, PROVENANCE);

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="iguazu-comparison-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Argentina · Brazil · Iguazú Falls ·&nbsp;<span>September 2026</span></div>
    <h1 id="iguazu-comparison-title" class="post-hero-title"><em>Iguazú Falls:</em><br />Argentina vs Brazil</h1>
    <p class="post-hero-sub">One waterfall system, two park days, and a comparison that is more useful than choosing a winner.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">2</span><span class="stat-label">Sides</span></div>
      <div class="stat"><span class="stat-num">2</span><span class="stat-label">Park Days</span></div>
      <div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div>
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">Waterfall System</span></div>
    </div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>

  <article class="post-body iguazu-comparison-body">
    <ArticleContent />
  </article>

  <style is:global>
    .iguazu-comparison-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .iguazu-comparison-body .article-photo picture,
    .iguazu-comparison-body .article-photo img { display: block; width: 100%; }
    .iguazu-comparison-body .article-photo img { height: auto; border: 1px solid rgba(158, 207, 114, 0.12); }
    .iguazu-comparison-body .article-photo figcaption { margin-top: 0.65rem; color: rgba(221, 232, 208, 0.62); font-size: 0.95rem; font-style: italic; text-align: center; }
    .iguazu-comparison-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.08; }
    .iguazu-comparison-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem, 3vw, 2.2rem); font-weight: 400; }
    .iguazu-comparison-body p,
    .iguazu-comparison-body ul,
    .iguazu-comparison-body table { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .iguazu-comparison-body ul { padding-left: 2rem; color: rgba(221, 232, 208, 0.86); font-size: 1.18rem; line-height: 1.7; }
    .iguazu-comparison-body strong { color: #e7f2da; }
    .iguazu-comparison-body table { border-collapse: collapse; color: rgba(221, 232, 208, 0.86); font-size: 1.05rem; line-height: 1.5; width: 100%; }
    .iguazu-comparison-body th,
    .iguazu-comparison-body td { border-bottom: 1px solid rgba(158, 207, 114, 0.2); padding: 0.9rem 0.75rem; text-align: left; vertical-align: top; }
    .iguazu-comparison-body th { color: #e7f2da; font-family: 'IM Fell English', Georgia, serif; font-size: 1.25rem; font-weight: 400; }
    .iguazu-comparison-body .comparison-note { max-width: 1100px; margin: 1.5rem auto; color: rgba(221, 232, 208, 0.68); font-size: 0.98rem; font-style: italic; }
    @media (max-width: 820px) {
      .iguazu-comparison-body .article-photo { margin: 2.5rem 0; }
      .iguazu-comparison-body h2,
      .iguazu-comparison-body h3,
      .iguazu-comparison-body p,
      .iguazu-comparison-body table { max-width: none; }
      .iguazu-comparison-body table { display: block; overflow-x: auto; }
    }
  </style>
</BaseLayout>
