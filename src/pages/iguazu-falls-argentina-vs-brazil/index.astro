---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/iguazu-falls-argentina-vs-brazil.md";
import AtAGlance from "../../components/chronicle/AtAGlance.astro";
import Practical from "../../components/chronicle/Practical.astro";
import PracticalSection from "../../components/chronicle/PracticalSection.astro";
import FurtherReading from "../../components/chronicle/FurtherReading.astro";
import ArticleFAQ from "../../components/chronicle/ArticleFAQ.astro";
import "../../styles/south-america-article.css";

const title = "Iguazú Falls: Argentina or Brazil? — There & Back Again";
const description = "A clear comparison of the Argentina and Brazil sides of Iguazú Falls: circuits and immersion in Argentina, panorama and wildlife additions in Brazil.";
const canonical = "https://there-and-back.mitchchadban.com/iguazu-falls-argentina-vs-brazil/";
const image = "/images/iguazu-falls-in-2-days/iguazu-falls-panorama-1200w.jpg";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Iguazú Falls: Argentina vs Brazil",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://there-and-back.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
      image: `https://there-and-back.mitchchadban.com${image}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://there-and-back.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://there-and-back.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "Iguazú Falls: Argentina vs Brazil", item: canonical },
      ],
    },
  ],
};

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="iguazu-comparison-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Argentina · Brazil · Iguazú Falls ·&nbsp;<span>September 2026</span></div>
    <h1 id="iguazu-comparison-title" class="post-hero-title"><em>Iguazú Falls:</em><br />Argentina vs Brazil</h1>
    <p class="post-hero-sub">One waterfall system, two different ways of seeing it.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">2</span><span class="stat-label">Sides</span></div>
      <div class="stat"><span class="stat-num">2</span><span class="stat-label">Park Days</span></div>
      <div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div>
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">Waterfall System</span></div>
    </div>
  </section>

  <article class="post-body south-america-post-body iguazu-comparison-body">
    <ArticleContent />
    <FurtherReading
      label="Further Reading"
      cards={[
        { href: "/iguazu-falls-in-2-days/", region: "Argentina · Brazil · Iguazú", title: "Iguazú Falls in 2 Days", excerpt: "A two-day sequence through the Argentine and Brazilian sides of the waterfall system.", cta: "READ CHRONICLE" },
        { href: "/24-days-in-south-america-itinerary/", region: "Argentina · Iguazú", title: "24 Days in South America", excerpt: "The wider overland journey through Peru, Bolivia, Chile, Argentina and Brazil.", cta: "READ CHRONICLE" },
        { href: "/5-days-in-buenos-aires-itinerary/", region: "Argentina · Buenos Aires", title: "5 Days in Buenos Aires: Complete Itinerary", excerpt: "Five days through Buenos Aires, from Plaza de Mayo and Recoleta to San Telmo, Palermo and the river edge.", cta: "READ CHRONICLE" },
      ]}
    />
  </article>

  <div class="iguazu-comparison-overview-slot">
    <AtAGlance
      id="iguazu-comparison-glance"
      title="Iguazú: Argentina vs Brazil at a Glance"
      meta={[
        { label: "Best for the fullest falls experience", value: "Argentina, with Garganta del Diablo plus Upper and Lower Circuits." },
        { label: "Best for the grand panorama", value: "Brazil, where the waterfall system opens across the opposite side of the gorge." },
        { label: "Best for a mixed day", value: "Brazil, especially when combining the falls with Macuco Safari and Parque das Aves." },
        { label: "Best overall plan", value: "Two full days, one on each side. The two parks solve different parts of the experience rather than duplicating each other." },
      ]}
      daysHeading="Four Ways to Choose"
      days={[
        { num: "Argentina", detail: "Immersion · Circuits · Changing viewpoints", text: "The stronger choice when the falls themselves are the priority. More walking, more elevation changes and more time moving through the waterfall system." },
        { num: "Brazil", detail: "Panorama · Compact route · Wide view", text: "The stronger side for understanding the scale of Iguazú in one broad composition across river, forest and falls." },
        { num: "One day", detail: "Choose the experience", text: "Pick Argentina for the fuller waterfall day. Pick Brazil for the panorama, a tighter schedule or a mixed falls, wildlife and boat day." },
        { num: "Two days", detail: "Do both · Cross the border", text: "Give each side its own day. Argentina explains the parts; Brazil shows how the parts belong together." },
      ]}
    />
  </div>

  <div class="iguazu-comparison-decision-slot">
    <Practical place="Iguazú — Argentina vs Brazil" detail="Immersion · panorama · two countries" detailIcon="🌊">
      <PracticalSection label="Shortest route to a decision" level={3}>
        <div class="prac-item"><strong>Falls are the whole reason for the trip</strong> — Choose Argentina.</div>
        <div class="prac-item"><strong>You want the strongest single panorama</strong> — Choose Brazil.</div>
        <div class="prac-item"><strong>You only have one day</strong> — Argentina for depth and variety; Brazil for a more compact visit or a mixed day with other nearby attractions.</div>
        <div class="prac-item"><strong>You have two days</strong> — Do both and treat the border crossing as part of the plan rather than dead time between attractions.</div>
      </PracticalSection>
      <PracticalSection label="What each side does best" level={3}>
        <div class="prac-item"><strong>Close-range immersion:</strong> Argentina.</div>
        <div class="prac-item"><strong>Variety of viewpoints:</strong> Argentina.</div>
        <div class="prac-item"><strong>Grand overall panorama:</strong> Brazil.</div>
        <div class="prac-item"><strong>Compact falls visit:</strong> Brazil.</div>
        <div class="prac-item"><strong>Mixed falls, wildlife and boat day:</strong> Brazil.</div>
      </PracticalSection>
      <PracticalSection label="Watch-outs" level={3}>
        <div class="tip-row"><strong>Check current walkway access on the Argentine side.</strong> High water and infrastructure conditions can affect Garganta del Diablo and other circuits.</div>
        <div class="tip-row"><strong>Do not underestimate the Brazil day.</strong> Macuco Safari and Parque das Aves turn a compact falls visit into a full itinerary.</div>
        <div class="tip-row"><strong>Leave border-crossing margin.</strong> Immigration and transport between Puerto Iguazú and Foz do Iguaçu can add friction.</div>
        <div class="tip-row"><strong>Check current entry requirements for both countries.</strong> Passport, visa and border rules depend on nationality and travel date.</div>
      </PracticalSection>
    </Practical>
  </div>

  <script is:inline>
    (() => {
      const article = document.querySelector('.iguazu-comparison-body');
      if (!article) return;
      const overview = document.querySelector('.iguazu-comparison-overview-slot');
      const decision = document.querySelector('.iguazu-comparison-decision-slot');
      const headings = [...article.querySelectorAll('h2')];
      const firstChapter = headings.find((heading) => heading.textContent?.trim().startsWith('I.'));
      const decisionHeading = headings.find((heading) => heading.textContent?.trim() === 'V. If you only have one day');
      if (overview && firstChapter) firstChapter.insertAdjacentElement('beforebegin', overview);
      if (decision && decisionHeading) decisionHeading.insertAdjacentElement('beforebegin', decision);
    })();
  </script>
  <ArticleFAQ page="iguazu-falls-argentina-vs-brazil" />
</BaseLayout>
