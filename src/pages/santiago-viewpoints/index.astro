---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/santiago-viewpoints.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "Santiago Viewpoints: San Cristóbal, Santa Lucía & Sky Costanera | There & Back Again";
const description = "A first-hand comparison of Santiago viewpoints: San Cristóbal, Santa Lucía and Sky Costanera, based on the recorded September 2026 route.";
const canonical = "https://travel.mitchchadban.com/santiago-viewpoints/";
const image = "/images/4-days-in-santiago-itinerary/santiago-skyline-mountain-backdrop-1200w.jpg";
const PROVENANCE = { photography: true };

const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Santiago Viewpoints: San Cristóbal, Santa Lucía and Sky Costanera",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
      image: `https://travel.mitchchadban.com${image}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "Santiago Viewpoints", item: canonical },
      ],
    },
  ],
}, PROVENANCE);

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="santiago-viewpoints-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Chile · Santiago ·&nbsp;<span>September 2026</span></div>
    <h1 id="santiago-viewpoints-title" class="post-hero-title"><em>Santiago Viewpoints:</em><br />San Cristóbal, Santa Lucía and Sky Costanera</h1>
    <p class="post-hero-sub">Three ways of reading the city from above.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">3</span><span class="stat-label">Viewpoints</span></div>
      <div class="stat"><span class="stat-num">4</span><span class="stat-label">Nights</span></div>
      <div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div>
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">City</span></div>
    </div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>

  <article class="post-body santiago-viewpoints-post-body">
    <ArticleContent />
  </article>

  <style is:global>
    .santiago-viewpoints-post-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .santiago-viewpoints-post-body .article-photo picture,
    .santiago-viewpoints-post-body .article-photo img { display: block; width: 100%; }
    .santiago-viewpoints-post-body .article-photo img { height: auto; border: 1px solid rgba(158, 207, 114, 0.12); }
    .santiago-viewpoints-post-body .article-photo figcaption { margin-top: 0.65rem; color: rgba(221, 232, 208, 0.62); font-size: 0.95rem; font-style: italic; text-align: center; }
    .santiago-viewpoints-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.08; }
    .santiago-viewpoints-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem, 3vw, 2.2rem); font-weight: 400; }
    .santiago-viewpoints-post-body p,
    .santiago-viewpoints-post-body ul,
    .santiago-viewpoints-post-body table { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .santiago-viewpoints-post-body ul { padding-left: 2rem; color: rgba(221, 232, 208, 0.86); font-size: 1.18rem; line-height: 1.7; }
    .santiago-viewpoints-post-body strong { color: #e7f2da; }
    .santiago-viewpoints-post-body table { border-collapse: collapse; color: rgba(221, 232, 208, 0.86); font-size: 1.05rem; line-height: 1.5; width: 100%; }
    .santiago-viewpoints-post-body th,
    .santiago-viewpoints-post-body td { border-bottom: 1px solid rgba(158, 207, 114, 0.2); padding: 0.9rem 0.75rem; text-align: left; vertical-align: top; }
    .santiago-viewpoints-post-body th { color: #e7f2da; font-family: 'IM Fell English', Georgia, serif; font-size: 1.25rem; font-weight: 400; }
    .santiago-viewpoints-post-body .practical-note { max-width: 1100px; margin: 1.5rem auto; border-left: 2px solid rgba(158, 207, 114, 0.55); padding: 0.2rem 1rem; color: rgba(221, 232, 208, 0.72); font-size: 1rem; }
    @media (max-width: 820px) {
      .santiago-viewpoints-post-body .article-photo { margin: 2.5rem 0; }
      .santiago-viewpoints-post-body h2,
      .santiago-viewpoints-post-body h3,
      .santiago-viewpoints-post-body p,
      .santiago-viewpoints-post-body ul,
      .santiago-viewpoints-post-body table { max-width: none; }
      .santiago-viewpoints-post-body table { display: block; overflow-x: auto; }
    }
  </style>
</BaseLayout>
