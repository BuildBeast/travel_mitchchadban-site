        value:
          'Ronda as a day trip — go, but sleep there. And Granada, unless you have Alhambra tickets in hand and accept a fourteen-hour day.',
      },
    ]}
    daysHeading="Destination by Destination"
    days={[
      { num: 'Itálica', text: 'Half day · ~30 min by bus · A Roman provincial capital and one of the largest amphitheatres of the empire. Closed Mondays.' },
