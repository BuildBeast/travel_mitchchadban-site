---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/colonia-del-sacramento-day-trip.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "Colonia del Sacramento Day Trip from Buenos Aires — There & Back Again";
const description = "An evidence-led account of the recorded Colonia del Sacramento day trip from Buenos Aires on 2 October 2026, including the time allocated, unresolved transport details and what the route record can actually support.";
const canonical = "https://travel.mitchchadban.com/colonia-del-sacramento-day-trip/";
const PROVENANCE = { photography: false };

const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Colonia del Sacramento Day Trip from Buenos Aires",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "Colonia del Sacramento Day Trip from Buenos Aires", item: canonical },
      ],
    },
  ],
}, PROVENANCE);

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article">
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="colonia-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Argentina → Uruguay ·&nbsp;<span>October 2026</span></div>
    <h1 id="colonia-title" class="post-hero-title"><em>Colonia del Sacramento Day Trip</em><br />from Buenos Aires</h1>
    <p class="post-hero-sub">A careful reconstruction of a recorded day beyond Buenos Aires, with the transport and sightseeing gaps left visible.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">Day trip</span></div>
      <div class="stat"><span class="stat-num">5h</span><span class="stat-label">Recorded in Colonia</span></div>
      <div class="stat"><span class="stat-num">2</span><span class="stat-label">Countries</span></div>
      <div class="stat"><span class="stat-num">0</span><span class="stat-label">Supported photos</span></div>
    </div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>

  <article class="post-body colonia-post-body">
    <ArticleContent />
  </article>

  <style is:global>
    .colonia-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.08; }
    .colonia-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem, 3vw, 2.2rem); font-weight: 400; }
    .colonia-post-body p,
    .colonia-post-body ul,
    .colonia-post-body ol { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .colonia-post-body ul,
    .colonia-post-body ol { padding-left: 2rem; color: rgba(221, 232, 208, 0.86); font-size: 1.18rem; line-height: 1.7; }
    .colonia-post-body strong { color: #e7f2da; }
    @media (max-width: 820px) {
      .colonia-post-body h2,
      .colonia-post-body h3,
      .colonia-post-body p,
      .colonia-post-body ul,
      .colonia-post-body ol { max-width: none; }
    }
  </style>
</BaseLayout>
