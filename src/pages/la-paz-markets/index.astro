---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/la-paz-markets.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "La Paz Markets: Witches’ Market & Mercado Rodríguez | There & Back Again";
const description = "A first-hand, evidence-led guide to the Witches’ Market and Mercado Rodríguez, with both stops placed inside a three-day La Paz route.";
const canonical = "https://travel.mitchchadban.com/la-paz-markets/";
const image = "/images/3-days-in-la-paz-itinerary/la-paz-central-market-street-1200w.jpg";
const PROVENANCE = { photography: true };

const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "La Paz Markets: Witches’ Market and Mercado Rodríguez",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
      image: `https://travel.mitchchadban.com${image}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "La Paz Markets", item: canonical },
      ],
    },
  ],
}, PROVENANCE);

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="la-paz-markets-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Bolivia · La Paz ·&nbsp;<span>September 2026</span></div>
    <h1 id="la-paz-markets-title" class="post-hero-title"><em>La Paz Markets:</em><br />Witches’ Market and Mercado Rodríguez</h1>
    <p class="post-hero-sub">Two market stops, placed inside the recorded route through the city.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">2</span><span class="stat-label">Markets</span></div>
      <div class="stat"><span class="stat-num">2</span><span class="stat-label">Route days</span></div>
      <div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div>
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">City</span></div>
    </div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>

  <article class="post-body la-paz-markets-post-body">
    <ArticleContent />
  </article>

  <style is:global>
    .la-paz-markets-post-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .la-paz-markets-post-body .article-photo picture,
    .la-paz-markets-post-body .article-photo img { display: block; width: 100%; }
    .la-paz-markets-post-body .article-photo img { height: auto; border: 1px solid rgba(158, 207, 114, 0.12); }
    .la-paz-markets-post-body .article-photo figcaption { margin-top: 0.65rem; color: rgba(221, 232, 208, 0.62); font-size: 0.95rem; font-style: italic; text-align: center; }
    .la-paz-markets-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.08; }
    .la-paz-markets-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem, 3vw, 2.2rem); font-weight: 400; }
    .la-paz-markets-post-body p,
    .la-paz-markets-post-body ul,
    .la-paz-markets-post-body table { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .la-paz-markets-post-body ul { padding-left: 2rem; color: rgba(221, 232, 208, 0.86); font-size: 1.18rem; line-height: 1.7; }
    .la-paz-markets-post-body strong { color: #e7f2da; }
    .la-paz-markets-post-body table { border-collapse: collapse; color: rgba(221, 232, 208, 0.86); font-size: 1.05rem; line-height: 1.5; width: 100%; }
    .la-paz-markets-post-body th,
    .la-paz-markets-post-body td { border-bottom: 1px solid rgba(158, 207, 114, 0.2); padding: 0.9rem 0.75rem; text-align: left; vertical-align: top; }
    .la-paz-markets-post-body th { color: #e7f2da; font-family: 'IM Fell English', Georgia, serif; font-size: 1.25rem; font-weight: 400; }
    @media (max-width: 820px) {
      .la-paz-markets-post-body .article-photo { margin: 2.5rem 0; }
      .la-paz-markets-post-body h2,
      .la-paz-markets-post-body h3,
      .la-paz-markets-post-body p,
      .la-paz-markets-post-body ul,
      .la-paz-markets-post-body table { max-width: none; }
      .la-paz-markets-post-body table { display: block; overflow-x: auto; }
    }
  </style>
</BaseLayout>
