---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/huaca-pucllana-lima.md";
import AtAGlance from "../../components/chronicle/AtAGlance.astro";
import Practical from "../../components/chronicle/Practical.astro";
import PracticalSection from "../../components/chronicle/PracticalSection.astro";
import FurtherReading from "../../components/chronicle/FurtherReading.astro";
import ArticleFAQ from "../../components/chronicle/ArticleFAQ.astro";
import "../../styles/south-america-article.css";

const title = "Huaca Pucllana, Lima: Is It Worth Visiting? | There & Back Again";
const description = "A first-hand visit to Huaca Pucllana in Miraflores, where Lima’s pre-Hispanic adobe architecture remains inside the modern city.";
const canonical = "https://there-and-back.mitchchadban.com/huaca-pucllana-lima/";
const image = "/images/3-days-in-lima-itinerary/lima-huaca-pucllana-1200w.jpg";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Huaca Pucllana, Lima: Is It Worth Visiting?",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://there-and-back.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
      image: `https://there-and-back.mitchchadban.com${image}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://there-and-back.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://there-and-back.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "Huaca Pucllana, Lima", item: canonical },
      ],
    },
  ],
};

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="huaca-pucllana-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Peru · Lima ·&nbsp;<span>September 2026</span></div>
    <h1 id="huaca-pucllana-title" class="post-hero-title"><em>Huaca Pucllana, Lima:</em><br />Is It Worth Visiting?</h1>
    <p class="post-hero-sub">An archaeological site inside the modern streets of Miraflores.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">Site</span></div>
      <div class="stat"><span class="stat-num">1–1.5</span><span class="stat-label">Hours</span></div>
      <div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div>
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">City</span></div>
    </div>
  </section>

  <article class="post-body south-america-post-body huaca-pucllana-post-body">
    <ArticleContent />
    <FurtherReading
      label="Further Reading"
      cards={[
        { href: "/best-things-to-do-in-lima/", region: "Peru · Lima", title: "Best Things to Do in Lima", excerpt: "A city guide through Lima’s historic centre, coastal districts, museums and archaeological layers.", cta: "READ CHRONICLE" },
        { href: "/barranco-to-miraflores-lima/", region: "Peru · Lima", title: "Barranco to Miraflores", excerpt: "A route through Lima’s southern neighbourhoods, from Barranco’s bridges to the Pacific edge of Miraflores.", cta: "READ CHRONICLE" },
        { href: "/3-days-in-lima-itinerary/", region: "Peru · Lima", title: "3 Days in Lima: Complete Itinerary", excerpt: "Three days through the Historic Centre, Barranco, Miraflores and the archaeological Lima beyond them.", cta: "READ CHRONICLE" },
      ]}
    />
  </article>

  <div class="huaca-pucllana-overview-slot">
    <AtAGlance
      id="huaca-pucllana-glance"
      title="Huaca Pucllana at a Glance"
      meta={[
        { label: "Best for", value: "Seeing pre-Hispanic Lima inside the modern city rather than outside it." },
        { label: "Time needed", value: "Around one to one and a half hours for a focused visit." },
        { label: "Best pairing", value: "Barranco or the Miraflores coast, then Pucllana as the archaeological layer beneath the contemporary district." },
        { label: "Best overall reason to go", value: "The contrast between adobe ceremonial architecture and modern Miraflores is the experience." },
      ]}
      daysHeading="Four Ways to Read the Site"
      days={[
        { num: "The City Around It", detail: "Miraflores · Apartments · Roads", text: "Pucllana survives inside modern Lima. The surrounding district is not background noise; it is part of why the site matters." },
        { num: "The Architecture", detail: "Adobe · Platforms · Ceremonial centre", text: "Thousands of small hand-formed bricks create stepped walls, plazas, ramps and terraces built by the Lima culture." },
        { num: "The Cultural Layers", detail: "Lima · Wari · Ychsma", text: "The site was reused over time, so the pyramid holds more than one cultural phase rather than one frozen historical moment." },
        { num: "The Visit", detail: "Circuit · Museum · 1–1.5 hours", text: "The archaeological route and exhibition space work together: one shows the site at scale, the other gives the objects and phases context." },
      ]}
    />
  </div>

  <div class="huaca-pucllana-decision-slot">
    <Practical place="Lima — Huaca Pucllana" detail="Archaeology · Miraflores · 1–1.5 hours" detailIcon="🏺">
      <PracticalSection label="Shortest route to a decision" level={3}>
        <div class="prac-item"><strong>One day in Lima</strong> — Prioritise the Historic Centre or Barranco and Miraflores first unless archaeology is a major interest.</div>
        <div class="prac-item"><strong>Two days</strong> — Pucllana becomes an easy addition to a Barranco and Miraflores day.</div>
        <div class="prac-item"><strong>Three days</strong> — It clearly earns its place as part of Lima’s archaeological layer.</div>
        <div class="prac-item"><strong>If you go</strong> — Allow roughly one to one and a half hours, with extra time if taking a longer guided circuit or spending more time in the museum.</div>
      </PracticalSection>
      <PracticalSection label="What the visit does best" level={3}>
        <div class="prac-item"><strong>Urban archaeology:</strong> Ancient architecture inside modern Miraflores.</div>
        <div class="prac-item"><strong>Construction:</strong> Adobe brick technique and stepped platforms.</div>
        <div class="prac-item"><strong>Historical depth:</strong> Lima, Wari and Ychsma use of the site.</div>
        <div class="prac-item"><strong>Context:</strong> Museum objects extending the archaeological circuit.</div>
      </PracticalSection>
      <PracticalSection label="Watch-outs" level={3}>
        <div class="tip-row"><strong>Check current opening days and entry arrangements.</strong> The site’s schedule and visit format can change, so check live information before travelling.</div>
        <div class="tip-row"><strong>Do not treat it as a remote ruin.</strong> The modern district around Pucllana is part of the site’s meaning.</div>
        <div class="tip-row"><strong>Do not overbuild the day.</strong> Huallamarca and Museo Larco are useful continuations, not compulsory additions.</div>
        <div class="tip-row"><strong>Keep the visit in proportion.</strong> Pucllana works because it is compact enough to add archaeological depth without consuming the whole day.</div>
      </PracticalSection>
    </Practical>
  </div>

  <script is:inline>
    (() => {
      const article = document.querySelector('.huaca-pucllana-post-body');
      if (!article) return;
      const overview = document.querySelector('.huaca-pucllana-overview-slot');
      const decision = document.querySelector('.huaca-pucllana-decision-slot');
      const headings = [...article.querySelectorAll('h2')];
      const firstChapter = headings.find((heading) => heading.textContent?.trim().startsWith('I.'));
      const timeDecision = headings.find((heading) => heading.textContent?.trim() === 'How much time do you need?');
      if (overview && firstChapter) firstChapter.insertAdjacentElement('beforebegin', overview);
      if (decision && timeDecision) timeDecision.insertAdjacentElement('beforebegin', decision);
    })();
  </script>
  <ArticleFAQ page="huaca-pucllana-lima" />
</BaseLayout>
