---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/3-days-in-granada-itinerary.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "3 Days in Granada: Complete Itinerary — There & Back Again";
const description = "A first-hand Granada itinerary centred on the Alhambra, Generalife, Albaicín, historic streets and the city’s layered architecture.";
const canonical = "https://travel.mitchchadban.com/3-days-in-granada-itinerary/";
const image = "/images/3-days-in-granada-itinerary/granada-alhambra-city-view-1200w.jpg";
const PROVENANCE = { photography: true };

const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article", headline: "3 Days in Granada: Complete Itinerary", description, author: { "@type": "Person", name: "Mitch Chadban" }, publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" }, mainEntityOfPage: { "@type": "WebPage", "@id": canonical }, url: canonical, inLanguage: "en-AU", image: `https://travel.mitchchadban.com${image}` },
    { "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" }, { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" }, { "@type": "ListItem", position: 3, name: "3 Days in Granada: Complete Itinerary", item: canonical } ] },
  ],
}, PROVENANCE);
const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />
  <section class="post-hero" aria-labelledby="granada-title">
    <div class="post-route-strip"><span>Europe</span>&nbsp;· Spain · Andalucía ·&nbsp;<span>Granada</span></div>
    <h1 id="granada-title" class="post-hero-title"><em>3 Days in Granada:</em><br />The Alhambra and the City Below</h1>
    <p class="post-hero-sub">A first-hand route through the Alhambra, the Generalife, the Albaicín and Granada’s historic centre.</p>
    <div class="post-stats"><div class="stat"><span class="stat-num">3</span><span class="stat-label">Days</span></div><div class="stat"><span class="stat-num">1</span><span class="stat-label">Palace city</span></div><div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div><div class="stat"><span class="stat-num">Granada</span><span class="stat-label">Base</span></div></div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>
  <article class="post-body granada-post-body"><ArticleContent /></article>
  <style is:global>
    .granada-post-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .granada-post-body .article-photo picture, .granada-post-body .article-photo img { display: block; width: 100%; }
    .granada-post-body .article-photo img { height: auto; border: 1px solid rgba(158, 207, 114, 0.12); }
    .granada-post-body .article-photo figcaption { margin-top: .65rem; color: rgba(221,232,208,.62); font-size: .95rem; font-style: italic; text-align: center; }
    .granada-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem,4vw,3.2rem); font-weight: 400; line-height: 1.08; }
    .granada-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem,3vw,2.2rem); font-weight: 400; }
    .granada-post-body p, .granada-post-body ul { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .granada-post-body ul { padding-left: 2rem; color: rgba(221,232,208,.86); font-size: 1.18rem; line-height: 1.7; }
    .granada-post-body strong { color: #e7f2da; }
    @media (max-width: 820px) { .granada-post-body .article-photo { margin: 2.5rem 0; } .granada-post-body h2, .granada-post-body h3, .granada-post-body p { max-width: none; } }
  </style>
</BaseLayout>
