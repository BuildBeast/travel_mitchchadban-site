---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/lima-historic-centre-san-francisco-catacombs.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "Lima Historic Centre & San Francisco Catacombs | There & Back Again";
const description = "A first-hand visit to Lima’s Historic Centre, from the Basilica of San Francisco and its unresolved catacomb entry to Plaza Mayor and central Lima’s surrounding streets.";
const canonical = "https://travel.mitchchadban.com/lima-historic-centre-san-francisco-catacombs/";
const image = "/images/3-days-in-lima-itinerary/lima-plaza-mayor-1200w.jpg";
const PROVENANCE = { photography: true };

const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Lima Historic Centre and the San Francisco Catacombs",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
      image: `https://travel.mitchchadban.com${image}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "Lima Historic Centre and the San Francisco Catacombs", item: canonical },
      ],
    },
  ],
}, PROVENANCE);

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="lima-centre-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Peru · Lima ·&nbsp;<span>September 2026</span></div>
    <h1 id="lima-centre-title" class="post-hero-title"><em>Lima Historic Centre</em><br />and the San Francisco Catacombs</h1>
    <p class="post-hero-sub">A first afternoon through Lima’s civic and religious centre, with the underground question kept honest.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">1</span><span class="stat-label">Afternoon</span></div>
      <div class="stat"><span class="stat-num">Sep</span><span class="stat-label">Visited</span></div>
      <div class="stat"><span class="stat-num">Lima</span><span class="stat-label">City</span></div>
      <div class="stat"><span class="stat-num">7</span><span class="stat-label">Recorded Stops</span></div>
    </div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>

  <article class="post-body lima-centre-post-body">
    <ArticleContent />
  </article>

  <style is:global>
    .lima-centre-post-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .lima-centre-post-body .article-photo picture,
    .lima-centre-post-body .article-photo img { display: block; width: 100%; }
    .lima-centre-post-body .article-photo img { height: auto; border: 1px solid rgba(158, 207, 114, 0.12); }
    .lima-centre-post-body .article-photo figcaption { margin-top: 0.65rem; color: rgba(221, 232, 208, 0.62); font-size: 0.95rem; font-style: italic; text-align: center; }
    .lima-centre-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.08; }
    .lima-centre-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem, 3vw, 2.2rem); font-weight: 400; }
    .lima-centre-post-body p,
    .lima-centre-post-body ul { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .lima-centre-post-body ul { padding-left: 2rem; color: rgba(221, 232, 208, 0.86); font-size: 1.18rem; line-height: 1.7; }
    .lima-centre-post-body strong { color: #e7f2da; }
    .lima-centre-post-body .practical-note { max-width: 1100px; margin: 1.5rem auto; border-left: 2px solid rgba(158, 207, 114, 0.55); padding: 0.2rem 1rem; color: rgba(221, 232, 208, 0.72); font-size: 1rem; }
    @media (max-width: 820px) {
      .lima-centre-post-body .article-photo { margin: 2.5rem 0; }
      .lima-centre-post-body h2,
      .lima-centre-post-body h3,
      .lima-centre-post-body p { max-width: none; }
    }
  </style>
</BaseLayout>
