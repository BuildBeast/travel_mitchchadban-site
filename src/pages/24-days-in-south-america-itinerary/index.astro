---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleContent from "../../content/24-days-in-south-america-itinerary.md";
import { provenanceHtml, withProvenance } from "../../lib/provenance";

const title = "24 Days in South America: Complete Itinerary — There & Back Again";
const description = "A first-hand 24-day South America itinerary through Peru, Bolivia, Chile, Argentina and Uruguay, including Machu Picchu, La Paz, Santiago, Mendoza, Iguazú Falls and Buenos Aires.";
const canonical = "https://travel.mitchchadban.com/24-days-in-south-america-itinerary/";
const image = "/images/2-days-in-machu-picchu-itinerary/machu-picchu-terraces-1200w.jpg";
const PROVENANCE = { photography: true };

const schema = withProvenance({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "24 Days in South America: Peru, Bolivia, Chile, Argentina and Uruguay",
      description,
      author: { "@type": "Person", name: "Mitch Chadban" },
      publisher: { "@type": "Organization", name: "There & Back Again", url: "https://travel.mitchchadban.com/" },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      url: canonical,
      inLanguage: "en-AU",
      image: `https://travel.mitchchadban.com${image}`,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://travel.mitchchadban.com/" },
        { "@type": "ListItem", position: 2, name: "Chronicles", item: "https://travel.mitchchadban.com/chronicles/" },
        { "@type": "ListItem", position: 3, name: "24 Days in South America: Complete Itinerary", item: canonical },
      ],
    },
  ],
}, PROVENANCE);

const jsonLd = `<script type="application/ld+json">${JSON.stringify(schema)}<\\/script>`;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" image={image}>
  <Fragment slot="head" set:html={jsonLd} />

  <section class="post-hero" aria-labelledby="south-america-title">
    <div class="post-route-strip"><span>South America</span>&nbsp;· Peru · Bolivia · Chile · Argentina · Uruguay ·&nbsp;<span>September–October 2026</span></div>
    <h1 id="south-america-title" class="post-hero-title"><em>24 Days in South America:</em><br />Peru, Bolivia, Chile, Argentina and Uruguay</h1>
    <p class="post-hero-sub">One route from Lima to Buenos Aires, through ruins, high cities, wine country, two sides of a waterfall and a day beyond the Río de la Plata.</p>
    <div class="post-stats">
      <div class="stat"><span class="stat-num">24</span><span class="stat-label">Days</span></div>
      <div class="stat"><span class="stat-num">5</span><span class="stat-label">Countries</span></div>
      <div class="stat"><span class="stat-num">9</span><span class="stat-label">Stops</span></div>
      <div class="stat"><span class="stat-num">8</span><span class="stat-label">Route images</span></div>
    </div>
    <Fragment set:html={provenanceHtml(PROVENANCE, { affiliate: false })} />
  </section>

  <article class="post-body south-america-post-body">
    <ArticleContent />
  </article>

  <style is:global>
    .south-america-post-body .article-photo { max-width: 1100px; margin: 3.5rem auto; }
    .south-america-post-body .article-photo picture,
    .south-america-post-body .article-photo img { display: block; width: 100%; }
    .south-america-post-body .article-photo img { height: auto; border: 1px solid rgba(158, 207, 114, 0.12); }
    .south-america-post-body .article-photo figcaption { margin-top: 0.65rem; color: rgba(221, 232, 208, 0.62); font-size: 0.95rem; font-style: italic; text-align: center; }
    .south-america-post-body h2 { max-width: 1100px; margin: 4.5rem auto 1.4rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.08; }
    .south-america-post-body h3 { max-width: 1100px; margin: 2.8rem auto 1rem; color: #9ecf72; font-family: 'IM Fell English', Georgia, serif; font-size: clamp(1.45rem, 3vw, 2.2rem); font-weight: 400; }
    .south-america-post-body p,
    .south-america-post-body ul,
    .south-america-post-body ol,
    .south-america-post-body table { max-width: 1100px; margin-left: auto; margin-right: auto; }
    .south-america-post-body ul,
    .south-america-post-body ol { padding-left: 2rem; color: rgba(221, 232, 208, 0.86); font-size: 1.18rem; line-height: 1.7; }
    .south-america-post-body table { width: 100%; border-collapse: collapse; color: rgba(221, 232, 208, 0.86); font-size: 1rem; line-height: 1.5; }
    .south-america-post-body th,
    .south-america-post-body td { padding: 0.85rem 0.65rem; border-bottom: 1px solid rgba(158, 207, 114, 0.2); text-align: left; vertical-align: top; }
    .south-america-post-body th { color: #e7f2da; font-family: 'IM Fell English', Georgia, serif; font-size: 1.15rem; font-weight: 400; }
    .south-america-post-body strong { color: #e7f2da; }
    @media (max-width: 820px) {
      .south-america-post-body .article-photo { margin: 2.5rem 0; }
      .south-america-post-body h2,
      .south-america-post-body h3,
      .south-america-post-body p,
      .south-america-post-body ul,
      .south-america-post-body ol,
      .south-america-post-body table { max-width: none; }
      .south-america-post-body table { display: block; overflow-x: auto; }
    }
  </style>
</BaseLayout>
