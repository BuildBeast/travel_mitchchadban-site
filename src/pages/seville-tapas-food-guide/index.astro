      srcset={`${IMG}/fruteria-mercado-de-triana-480w.jpg 480w, ${IMG}/fruteria-mercado-de-triana-768w.jpg 768w, ${IMG}/fruteria-mercado-de-triana-1200w.jpg 1200w, ${IMG}/fruteria-mercado-de-triana-1600w.jpg 1600w, ${IMG}/fruteria-mercado-de-triana.jpg 2048w`}
