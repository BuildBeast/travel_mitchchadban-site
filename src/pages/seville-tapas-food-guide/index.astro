      srcset={`${IMG}/mercado-de-triana-entrance-480w.jpg 480w, ${IMG}/mercado-de-triana-entrance-768w.jpg 768w, ${IMG}/mercado-de-triana-entrance-1200w.jpg 1200w, ${IMG}/mercado-de-triana-entrance-1600w.jpg 1600w, ${IMG}/mercado-de-triana-entrance.jpg 2048w`}
