        { href: '/mi-teleferico-la-paz/', region: 'Bolivia · La Paz', title: 'Mi Teleférico: Exploring La Paz by Cable Car', excerpt: 'A closer look at the cable-car system and the geography it reveals above the streets.', cta: 'READ CHRONICLE' },
      ]}
    />
  </div>
  <ArticleFAQ page="best-things-to-do-in-la-paz" />
</ChronicleLayout>
