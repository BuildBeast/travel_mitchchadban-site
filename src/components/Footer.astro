---
// Shared site footer. Rendered once per page by BaseLayout, immediately after
// </main>, so every route ends with the same contentinfo landmark.
//
// Destinations mirror the header's primary navigation exactly — this footer
// deliberately introduces no new pages, no social links and no newsletter.
const NAV = [
  { href: '/chronicles/', label: 'Chronicles' },
  { href: '/by-region/', label: 'By Region' },
  { href: '/about-the-traveller/', label: 'The Traveller' },
];

// Build-time year. Never hard-coded, so the line cannot go stale or run ahead.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <span class="site-footer__wordmark">There &amp; Back Again</span>
        <p class="site-footer__statement">
          A literary travel chronicle by Mitch Chadban, written for those who
          travel not merely to arrive, but to be changed by the road.
        </p>
      </div>

      <nav class="site-footer__nav" aria-label="Footer navigation">
        <span class="site-footer__nav-label">Explore</span>
        <ul class="site-footer__nav-list">
          {NAV.map((item) => (
            <li class="site-footer__nav-item">
              <a class="site-footer__nav-link" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="site-footer__closing">
      <span class="site-footer__colophon">
        <span class="site-footer__copyright">&copy; {year} Mitch Chadban</span>
        <span class="site-footer__dot" aria-hidden="true"></span>
        <span class="site-footer__mark">There &amp; Back Again</span>
      </span>

      <a class="site-footer__return" href="#main-content">Back to the beginning</a>
    </div>
  </div>
</footer>

<style>
  /* ── Shell ───────────────────────────────────────────────────────────── */

  .site-footer {
    background: #0a0f08;
    border-top: 0.5px solid rgba(160, 200, 120, 0.1);
  }

  /* Reproduces the site's wide-content geometry exactly: an 8rem gutter
     outside a 1100px measure. The footer element itself stays a plain block
     and carries no padding of its own. */
  .site-footer__inner {
    max-width: calc(1100px + 16rem);
    margin: 0 auto;
    padding: 4rem 8rem 3rem;
  }

  /* ── Main row: brand left, navigation right ──────────────────────────── */

  .site-footer__main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.8rem 4rem;
  }

  .site-footer__brand {
    flex: 1 1 22rem;
    min-width: 0;
  }

  .site-footer__wordmark {
    display: block;
    font-family: 'IM Fell English', Georgia, serif;
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0.09em;
    color: #7db05a;
    text-transform: uppercase;
  }

  .site-footer__statement {
    max-width: 46ch;
    margin-top: 1.15rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.02rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.62;
    letter-spacing: 0.005em;
    color: rgba(221, 232, 208, 0.68);
    text-transform: none;
  }

  /* ── Navigation ──────────────────────────────────────────────────────── */

  /* global.css carries a bare `nav { … }` rule — sticky, flex, full-bleed and
     opaque. It is NOT dead: it is what makes the AnchorNav and the By Region
     switcher sticky, so it stays. Unset the parts of it that would otherwise
     reach this element. Ordinary declarations, no !important needed. */
  .site-footer__nav {
    position: static;
    display: block;
    flex: 0 0 auto;
    padding: 0;
    background: transparent;
    border-bottom: 0;
    text-align: right;
  }

  .site-footer__nav-label {
    display: block;
    margin-bottom: 1.1rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.22em;
    color: rgba(221, 232, 208, 0.55);
    text-transform: uppercase;
  }

  .site-footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__nav-item + .site-footer__nav-item {
    margin-top: 0.75rem;
  }

  .site-footer__nav-link {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.05em;
    color: rgba(221, 232, 208, 0.82);
    /* Underlined so the links do not depend on colour alone. Kept at a
       hairline, but opaque enough to clear 3:1 against the background as a
       non-text indicator. */
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-decoration-color: rgba(160, 200, 120, 0.5);
    text-underline-offset: 0.32em;
    transition: color 0.3s, text-decoration-color 0.3s;
  }

  /* ── Closing row ─────────────────────────────────────────────────────── */

  .site-footer__closing {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7rem 2.5rem;
    margin-top: 3.2rem;
    padding-top: 1.6rem;
    border-top: 0.5px solid rgba(160, 200, 120, 0.09);
  }

  .site-footer__colophon {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 12.5px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.13em;
    color: rgba(221, 232, 208, 0.55);
    text-transform: uppercase;
  }

  /* The site's existing 3px marker, reused as the only ornament here. */
  .site-footer__dot {
    flex: 0 0 auto;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #3d6b25;
  }

  .site-footer__return {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 0.98rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: rgba(221, 232, 208, 0.66);
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-decoration-color: rgba(160, 200, 120, 0.5);
    text-underline-offset: 0.32em;
    transition: color 0.3s, text-decoration-color 0.3s;
  }

  /* ── Interaction ─────────────────────────────────────────────────────── */

  .site-footer__nav-link:hover,
  .site-footer__return:hover {
    color: #9ecf72;
    text-decoration-color: rgba(158, 207, 114, 0.6);
  }

  /* Matches the header's focus treatment. */
  .site-footer__nav-link:focus-visible,
  .site-footer__return:focus-visible {
    outline: 1px solid rgba(158, 207, 114, 0.45);
    outline-offset: 4px;
  }

  /* ── Tablet ──────────────────────────────────────────────────────────── */

  @media (max-width: 1024px) {
    .site-footer__inner {
      padding-left: 4rem;
      padding-right: 4rem;
    }

    .site-footer__main {
      gap: 2.6rem 3rem;
    }
  }

  /* ── Tablet / touch ──────────────────────────────────────────────────── */

  /* Below the header's own 820px switch the page is being read on a touch
     device, so the targets grow — but the brand/Explore split still has room
     and is kept, per the two-part hierarchy. */
  @media (max-width: 820px) {
    .site-footer__inner {
      padding: 3.2rem 1.5rem 2.6rem;
    }

    .site-footer__main {
      gap: 2.4rem 3rem;
    }

    .site-footer__nav-item + .site-footer__nav-item {
      margin-top: 0;
    }

    .site-footer__nav-link,
    .site-footer__return {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  /* ── Mobile ──────────────────────────────────────────────────────────── */

  /* Below this the two columns would start to crowd each other, so the
     footer becomes a single stack. */
  @media (max-width: 620px) {
    .site-footer__inner {
      padding: 3rem 1.5rem 2.4rem;
    }

    .site-footer__main {
      flex-direction: column;
      gap: 2.2rem;
    }

    .site-footer__brand {
      flex: 0 0 auto;
    }

    .site-footer__statement {
      max-width: none;
    }

    .site-footer__nav {
      width: 100%;
      text-align: left;
    }

    /* Full-width, comfortably tall targets — rows, not buttons. */
    .site-footer__nav-link {
      display: flex;
      width: 100%;
      font-size: 1.12rem;
    }

    .site-footer__closing {
      margin-top: 2.4rem;
      padding-top: 1.4rem;
    }

    .site-footer__return {
      display: flex;
    }
  }

  @media (max-width: 560px) {
    /* Copyright and wordmark read better as two quiet lines than one
       tracked-out line squeezed into the gutter. */
    .site-footer__colophon {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }

    .site-footer__dot {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .site-footer__inner {
      padding-left: 1.1rem;
      padding-right: 1.1rem;
    }
  }

  @media (max-width: 420px) {
    .site-footer__inner {
      padding-left: 0.95rem;
      padding-right: 0.95rem;
    }
  }

  /* ── Motion ──────────────────────────────────────────────────────────── */

  /* The footer animates nothing; only the hover colour fade is a transition. */
  @media (prefers-reduced-motion: reduce) {
    .site-footer__nav-link,
    .site-footer__return {
      transition: none;
    }
  }
</style>
