interface Props { page: string; }
const { page } = Astro.props;
const faqItems = faqByPage[page];
if (!faqItems) throw new Error(`Missing ArticleFAQ record for ${page}`);
const faqId = `${page}-faq`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<section class="faq-block article-faq" aria-labelledby={faqId}>
  <div class="faq-inner">
    <div class="faq-title" id={faqId}>Frequently Asked Questions</div>
    {faqItems.map((item) => (
      <div class="faq-item">
        <div class="faq-q">{item.question}</div>
        <div class="faq-a">{item.answer}</div>
      </div>
    ))}
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

<script is:inline>
  (() => {
    const faq = document.currentScript?.previousElementSibling?.previousElementSibling;
    const next = document.querySelector('.next-chronicles');
    if (faq && next && next.compareDocumentPosition(faq) & Node.DOCUMENT_POSITION_FOLLOWING) next.insertAdjacentElement('beforebegin', faq);
  })();
</script>
