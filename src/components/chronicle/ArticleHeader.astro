---
/**
 * Article hero. Emits the same DOM as the legacy chronicles' `.post-hero`
 * block, so it inherits existing typography and spacing with no new CSS.
 */
import type { ChronicleMeta, HeroStat } from './types';
import { bylineText, formatPublished, DISCLOSURE } from '../../lib/provenance';

interface Props {
  /** Route strip, e.g. ['Spain', 'Andalucía', 'Seville']. */
  route?: string[];
  /** Small kicker above the title, e.g. 'Itinerary · Three Days'. */
  label?: string;
  /** Main title. Rendered as the page's single <h1>. */
  title: string;
  /** Optional second line of the title, rendered in italics beneath. */
  titleEmphasis?: string;
  /** Standfirst / deck. */
  standfirst: string;
  /** Up to four hero stats. */
  stats?: HeroStat[];
  /**
   * The page's `meta`. Supplies the byline, the visible publication date and
   * the affiliate disclosure, so a page declares its provenance once.
   */
  provenance?: ChronicleMeta;
}

const {
  route = [],
  label,
  title,
  titleEmphasis,
  standfirst,
  stats = [],
  provenance,
} = Astro.props;

const photography = provenance?.photography !== false;
const published = provenance?.datePublished;
const affiliate = provenance?.affiliateLinks === true;
---

<div class="post-hero">
  {
    route.length > 0 && (
      <div class="post-route-strip">
        {route.map((place, i) => (
          <>
            {i > 0 && <Fragment set:html="&nbsp;·&nbsp;" />}
            <span>{place}</span>
          </>
        ))}
      </div>
    )
  }

  {label && <div class="page-label">{label}</div>}

  <h1 class="post-hero-title">
    {title}{titleEmphasis && (<><br /><em>{titleEmphasis}</em></>)}
  </h1>

  <p class="post-hero-sub">{standfirst}</p>

  {
    stats.length > 0 && (
      <div class="post-stats">
        {stats.map((stat) => (
          <div class="stat">
            <span class="stat-num">{stat.num}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    )
  }

  {
    provenance && (
      <div class="article-provenance">
        <p class="article-byline">
          {bylineText(photography)}{' '}
          <a href="/about-the-traveller/">Mitch Chadban</a>
          {published && (
            <>
              <span class="article-byline__sep" aria-hidden="true" />
              <span class="article-byline__date">
                Published <time datetime={published}>{formatPublished(published)}</time>
              </span>
            </>
          )}
        </p>
        {affiliate && <p class="affiliate-disclosure">{DISCLOSURE}</p>}
      </div>
    )
  }
</div>

<style>
  /* `global.css` gives `.post-stats` a `max-width` with `margin: 0`, so between
     roughly 700px and 1024px the block sits flush against the left padding edge
     and leaves a wide empty gap to its right. Centring it is a one-line
     correction. This style is component-scoped, so it applies to new chronicles
     only — legacy pages keep their existing behaviour untouched. */
  .post-stats {
    margin-inline: auto;
  }
</style>
